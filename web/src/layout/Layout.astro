---
import { websiteConfig } from '@/config'
import type { PageMeta } from '@/types'
import { Font } from 'astro:assets'
import { VERCEL_ENV } from 'astro:env/server'
import { ClientRouter } from 'astro:transitions'
import '../styles.css'
import Footer from './Footer.astro'
import Header from './Header.astro'
import SEOMetadata from './SEOMetadata.astro'

type Props = {
  meta: PageMeta
  lang?: string
  enableAnalytics?: boolean
}

const { meta, lang = websiteConfig.lang, enableAnalytics = true } = Astro.props

const enablePlausible = VERCEL_ENV === 'production' && enableAnalytics
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href={websiteConfig.icon} type="image/png" />
    <link rel="apple-touch-icon" href={websiteConfig.icon} />
    <meta name="theme-color" content={websiteConfig.themeColor} />
    <meta name="format-detection" content="telephone=no" />

    <Font cssVariable="--font-sora" preload />
    <Font cssVariable="--font-hanken-grotesk" preload />

    <SEOMetadata {...meta} lang={lang} />

    {enablePlausible && (
      <>
        <script
          is:inline
          id="psbl"
          data-domain={websiteConfig.domain}
          src="/js/script.js"
          async
        ></script>
        <script
          is:inline
          set:html={`window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) }`}
        ></script>
      </>
    )}

    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="bg-rich-blue text-alice-blue sr-only z-50 rounded-md px-4 py-2 focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
