---
import { aboutPages } from '@/about'
import Container from '@/components/ui/Container.astro'
import Logo from '@/components/ui/Logo.astro'
import ClosingBackdrop from '@/layout/ClosingBackdrop.astro'
import { websiteConfig } from '@/config'
import { getContent } from '@/data'
import { getLocale, localizePath } from '@/i18n'
import { legalPages } from '@/legal'
import { resourcePages } from '@/resources'

const locale = getLocale(Astro.url)
const { site, resources, about, legal } = getContent(locale)
const { tagline } = site
// The Resources and About Fleet columns mirror their menus.
const footerColumns = [
  ...site.footerColumns,
  {
    title: resources.menu.label,
    links: resourcePages.map((entry) => ({
      label: resources.pages[entry.id].label,
      href: entry.href,
    })),
  },
  {
    title: about.menu.label,
    links: aboutPages.map((entry) => ({ label: about.pages[entry.id].label, href: entry.href })),
  },
]
const { name, socialLinks } = websiteConfig
const { labels } = site
const socials = [
  { label: labels.linkedIn, href: socialLinks.linkedIn, icon: 'linkedin' },
  { label: labels.youTube, href: socialLinks.youTube, icon: 'youtube' },
] as const
---

<!-- The footer is dark everywhere and carries its own grid glow. -->
<footer
  data-brand="c"
  class="border-border brand-c:border-hairline relative isolate overflow-hidden border-t bg-black"
>
  <ClosingBackdrop />
  <Container class="flex flex-wrap justify-between gap-12 py-12">
    <div class="flex max-w-[280px] flex-col gap-3">
      <Logo tone="light" />
      <p class="text-azul-blue brand-c:text-fog text-sm leading-[1.55]">{tagline}</p>
      <nav aria-label={labels.socialNav} class="mt-2">
        <ul class="flex gap-3">
          {socials.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${social.label} ${labels.newTab}`}
                class="bg-steel text-cream hover:bg-steel-soft hover:text-navy-deep focus-visible:outline-cream flex size-10 items-center justify-center rounded-full transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
              >
                {social.icon === 'linkedin' ? (
                  <svg
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="size-[18px]"
                    aria-hidden="true"
                  >
                    <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4V21H3V9.75Zm6.5 0h3.83v1.54h.06c.53-.95 1.84-1.96 3.79-1.96 4.05 0 4.8 2.53 4.8 5.83V21h-4v-5.12c0-1.22-.02-2.79-1.75-2.79-1.75 0-2.02 1.33-2.02 2.7V21h-4V9.75Z" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 24" fill="currentColor" class="size-5" aria-hidden="true">
                    <path d="M23.5 6.5a3 3 0 0 0-2.1-2.1C19.5 3.9 12 3.9 12 3.9s-7.5 0-9.4.5A3 3 0 0 0 .5 6.5 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.5 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.5ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z" />
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="flex flex-wrap gap-16 text-sm">
      {footerColumns.map((column) => (
        <nav aria-label={column.title} class="flex flex-col gap-2.5">
          <p class="font-display brand-c:text-cream font-semibold">{column.title}</p>
          <ul class="flex flex-col gap-2.5">
            {column.links.map((link) => (
              <li>
                <a
                  href={localizePath(link.href, locale)}
                  class="text-azul-blue hover:text-rich-blue brand-c:text-fog brand-c:hover:text-cream transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
  </Container>
  <Container class="text-muted brand-c:text-fog flex flex-wrap items-center justify-between gap-x-8 gap-y-3 pb-8 text-[13px]">
    <p>{`© ${new Date().getFullYear()} ${name}`}</p>
    <nav aria-label={legal.navLabel}>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {legalPages.map((entry) => (
          <li>
            <a
              href={localizePath(entry.href, locale)}
              class="hover:text-rich-blue brand-c:hover:text-cream transition-colors"
            >
              {legal.pages[entry.id].label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </Container>
</footer>
