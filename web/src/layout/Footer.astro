---
import NewsletterSignup from '@/components/newsletter/NewsletterSignup.astro'
import Container from '@/components/ui/Container.astro'
import Logo from '@/components/ui/Logo.astro'
import { websiteConfig } from '@/config'
import { getContent } from '@/data'
import { getLocale, localizePath } from '@/i18n'

const locale = getLocale(Astro.url)
const { footerColumns, tagline } = getContent(locale).site
const { name } = websiteConfig
---

<footer class="border-border border-t">
  <Container class="flex flex-wrap justify-between gap-12 py-12">
    <div class="flex max-w-[280px] flex-col gap-3">
      <Logo />
      <p class="text-azul-blue text-sm leading-[1.55]">{tagline}</p>
    </div>
    <div class="flex flex-wrap gap-16 text-sm">
      {footerColumns.map((column) => (
        <nav aria-label={column.title} class="flex flex-col gap-2.5">
          <p class="font-display font-semibold">{column.title}</p>
          <ul class="flex flex-col gap-2.5">
            {column.links.map((link) => (
              <li>
                <a
                  href={localizePath(link.href, locale)}
                  class="text-azul-blue hover:text-rich-blue transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <NewsletterSignup />
  </Container>
  <Container class="text-muted pb-8 text-[13px]">
    {`© ${new Date().getFullYear()} ${name}`}
  </Container>
</footer>
