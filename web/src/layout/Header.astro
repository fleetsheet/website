---
import Button from '@/components/ui/Button.astro'
import Container from '@/components/ui/Container.astro'
import Logo from '@/components/ui/Logo.astro'
import { websiteConfig } from '@/config'
import Menu from '@lucide/astro/icons/menu'
import X from '@lucide/astro/icons/x'

const { headerLinks, actions } = websiteConfig
---

<header id="site-header" class="bg-page border-border sticky top-0 z-40 border-b">
  <Container class="flex items-center gap-8 py-3.5">
    <a href="/" aria-label={`${websiteConfig.name} home`} class="rounded-md">
      <Logo size="lg" />
    </a>

    <nav aria-label="Main" class="hidden flex-1 lg:block">
      <ul class="flex flex-wrap gap-6 text-[15px] font-medium">
        {headerLinks.map((link) => (
          <li>
            <a href={link.href} class="text-azul-blue hover:text-rich-blue transition-colors">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto hidden items-center gap-2 sm:flex">
      <Button href={actions.signIn.href} variant="ghost" size="sm">
        {actions.signIn.label}
      </Button>
      <Button href={actions.bookDemo.href} size="sm" class="font-semibold">
        {actions.bookDemo.label}
      </Button>
    </div>

    <button
      type="button"
      id="site-menu-button"
      class="group text-rich-blue hover:bg-border ml-auto rounded-md p-2 sm:ml-0 lg:hidden"
      aria-controls="site-menu"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <Menu class="size-6 group-aria-expanded:hidden" aria-hidden="true" />
      <X class="hidden size-6 group-aria-expanded:block" aria-hidden="true" />
    </button>
  </Container>

  <div id="site-menu" class="border-border bg-page hidden border-t lg:hidden">
    <Container class="flex flex-col gap-6 py-6">
      <nav aria-label="Mobile">
        <ul class="flex flex-col gap-1 text-lg font-medium">
          {headerLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:bg-border block rounded-md px-2 py-2">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="flex flex-col gap-2 sm:hidden">
        <Button href={actions.signIn.href} variant="secondary">
          {actions.signIn.label}
        </Button>
        <Button href={actions.bookDemo.href}>{actions.bookDemo.label}</Button>
      </div>
    </Container>
  </div>
</header>

<script>
  const setMenuOpen = (open: boolean) => {
    const button = document.getElementById('site-menu-button')
    const menu = document.getElementById('site-menu')

    if (!button || !menu) {
      return
    }

    button.setAttribute('aria-expanded', String(open))
    button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu')
    menu.classList.toggle('hidden', !open)
  }

  document.addEventListener('keydown', (event) => {
    const button = document.getElementById('site-menu-button')

    if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      setMenuOpen(false)
      button.focus()
    }
  })

  document.addEventListener('astro:page-load', () => {
    const button = document.getElementById('site-menu-button')
    const menu = document.getElementById('site-menu')

    button?.addEventListener('click', () => {
      setMenuOpen(button.getAttribute('aria-expanded') !== 'true')
    })

    menu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenuOpen(false))
    })
  })
</script>
