---
import PlatformIcon from '@/components/platform/PlatformIcon.astro'
import ResourceIcon from '@/components/resources/ResourceIcon.astro'
import SolutionIcon from '@/components/solutions/SolutionIcon.astro'
import Button from '@/components/ui/Button.astro'
import Container from '@/components/ui/Container.astro'
import IconChip from '@/components/ui/IconChip.astro'
import Logo from '@/components/ui/Logo.astro'
import type { NavLink } from '@/config'
import { getContent } from '@/data'
import { getLocale, localizePath } from '@/i18n'
import { platformGroups, platformPages, type PlatformPageId } from '@/platform'
import { resourceGroups, resourcePages, type ResourcePageId } from '@/resources'
import { solutionGroups, solutionPages, type SolutionPageId } from '@/solutions'
import ChevronDown from '@lucide/astro/icons/chevron-down'
import Menu from '@lucide/astro/icons/menu'
import MessageCircle from '@lucide/astro/icons/message-circle'
import X from '@lucide/astro/icons/x'
import LanguageSwitcher, { type Translation } from './LanguageSwitcher.astro'

type Props = {
  translations: Translation[]
}

type MenuEntry = { href: string; label: string; summary?: string } & (
  | { kind: 'platform'; id: PlatformPageId }
  | { kind: 'solution'; id: SolutionPageId }
  | { kind: 'resource'; id: ResourcePageId }
  | { kind: 'contact' }
)

const { translations } = Astro.props
const locale = getLocale(Astro.url)
const content = getContent(locale)
const { headerLinks, actions, labels } = content.site
const { platform, solutions, resources } = content
const localize = (href: string) => localizePath(href, locale)
const megaMenus = [
  {
    id: 'platform',
    label: platform.menu.label,
    promo: platform.menu.promo,
    groups: platformGroups.map((group) => ({
      id: group,
      compact: false,
      title: platform.menu.groups[group],
      entries: platformPages
        .filter((entry) => entry.group === group)
        .map((entry): MenuEntry => ({
          kind: 'platform',
          id: entry.id,
          href: entry.href,
          ...platform.pages[entry.id],
        })),
    })),
  },
  {
    id: 'solutions',
    label: solutions.menu.label,
    promo: solutions.menu.promo,
    groups: solutionGroups.map((group) => ({
      id: group,
      // Industries are many: list them compactly in two columns, closing with a contact link.
      compact: group === 'industry',
      title: solutions.menu.groups[group],
      entries: [
        ...solutionPages
          .filter((entry) => entry.group === group)
          .map((entry): MenuEntry => ({
            kind: 'solution',
            id: entry.id,
            href: entry.href,
            label: solutions.pages[entry.id].label,
            summary: group === 'industry' ? undefined : solutions.pages[entry.id].summary,
          })),
        ...(group === 'industry'
          ? [
              {
                kind: 'contact',
                href: '/contact',
                label: solutions.menu.contact,
              } satisfies MenuEntry,
            ]
          : []),
      ],
    })),
  },
  {
    id: 'resources',
    label: resources.menu.label,
    promo: resources.menu.promo,
    groups: resourceGroups.map((group) => ({
      id: group,
      compact: false,
      title: resources.menu.groups[group],
      entries: resourcePages
        .filter((entry) => entry.group === group)
        .map((entry): MenuEntry => ({
          kind: 'resource',
          id: entry.id,
          href: entry.href,
          ...resources.pages[entry.id],
        })),
    })),
  },
]
type MegaMenu = (typeof megaMenus)[number]
// Navigation order: the dropdowns (Platform, Solutions, Resources), then plain links.
const navItems: ({ kind: 'mega'; menu: MegaMenu } | { kind: 'link'; link: NavLink })[] = [
  ...megaMenus.map((menu) => ({ kind: 'mega' as const, menu })),
  ...headerLinks.map((link) => ({ kind: 'link' as const, link })),
]
---

<header id="site-header" class="bg-page border-border sticky top-0 z-40 border-b">
  <Container class="flex items-center gap-8 py-3.5">
    <a href={localize('/')} aria-label={labels.home} class="rounded-md">
      <Logo />
    </a>

    <nav aria-label={labels.mainNav} class="hidden flex-1 lg:block">
      <ul class="flex flex-wrap items-center gap-6 text-[15px] font-medium">
        {navItems.map((item) =>
          item.kind === 'mega' ? (
            <li>
              <button
                type="button"
                id={`${item.menu.id}-menu-button`}
                class="group text-azul-blue hover:text-rich-blue aria-expanded:text-rich-blue flex items-center gap-1 transition-colors"
                aria-controls={`${item.menu.id}-menu`}
                aria-expanded="false"
                data-mega-button
              >
                {item.menu.label}
                <ChevronDown
                  class="size-4 transition-transform group-aria-expanded:rotate-180"
                  aria-hidden="true"
                />
              </button>
            </li>
          ) : (
            <li>
              <a
                href={localize(item.link.href)}
                class="text-azul-blue hover:text-rich-blue transition-colors"
              >
                {item.link.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>

    <div class="ms-auto flex items-center gap-2">
      <LanguageSwitcher
        id="language"
        locale={locale}
        label={labels.language}
        translations={translations}
      />
      <div class="hidden items-center gap-2 sm:flex">
        <Button href={localize(actions.signIn.href)} variant="ghost" size="sm">
          {actions.signIn.label}
        </Button>
        <Button href={localize(actions.bookDemo.href)} size="sm" class="font-semibold">
          {actions.bookDemo.label}
        </Button>
      </div>
      <button
        type="button"
        id="site-menu-button"
        class="group text-rich-blue hover:bg-border rounded-md p-2 lg:hidden"
        aria-controls="site-menu"
        aria-expanded="false"
        aria-label={labels.openMenu}
        data-open-label={labels.openMenu}
        data-close-label={labels.closeMenu}
      >
        <Menu class="size-6 group-aria-expanded:hidden" aria-hidden="true" />
        <X class="hidden size-6 group-aria-expanded:block" aria-hidden="true" />
      </button>
    </div>
  </Container>

  {megaMenus.map((megaMenu) => (
    <div
      id={`${megaMenu.id}-menu`}
      class="bg-surface border-border absolute inset-x-0 top-full hidden border-b shadow-lg lg:data-open:block"
      data-mega-panel
    >
      <Container
        class:list={[
          'grid gap-10 py-8',
          megaMenu.groups.some((group) => group.compact)
            ? 'lg:grid-cols-[1fr_1.35fr_240px]'
            : megaMenu.groups.length > 1
              ? 'lg:grid-cols-[1fr_1fr_280px]'
              : 'lg:grid-cols-[1fr_280px]',
        ]}
      >
        {megaMenu.groups.map((group) => (
          <div class="flex flex-col gap-3">
            <p class="eyebrow text-muted px-3">{group.title}</p>
            <ul
              class:list={[
                'grid grid-cols-1 gap-1',
                (megaMenu.groups.length === 1 || group.compact) && 'lg:grid-cols-2',
              ]}
            >
              {group.entries.map((entry) => (
                <li class:list={[entry.kind === 'contact' && 'lg:col-span-2']}>
                  <a
                    href={localize(entry.href)}
                    class:list={[
                      'hover:bg-page flex gap-3 rounded-lg transition-colors',
                      group.compact ? 'items-center px-3 py-2' : 'items-start p-3',
                      entry.kind === 'contact' && 'bg-page mt-1',
                    ]}
                  >
                    <IconChip size={group.compact ? 'sm' : 'md'}>
                      {entry.kind === 'platform' ? (
                        <PlatformIcon id={entry.id} />
                      ) : entry.kind === 'solution' ? (
                        <SolutionIcon id={entry.id} />
                      ) : entry.kind === 'resource' ? (
                        <ResourceIcon id={entry.id} />
                      ) : (
                        <MessageCircle />
                      )}
                    </IconChip>
                    <span class="flex flex-col gap-0.5">
                      <span
                        class:list={[
                          'text-rich-blue font-semibold',
                          group.compact ? 'text-sm' : 'text-[15px]',
                        ]}
                      >
                        {entry.label}
                      </span>
                      {entry.summary && (
                        <span class="text-azul-blue text-sm leading-snug">{entry.summary}</span>
                      )}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
        <div class="bg-supergraphic flex flex-col items-start gap-3 rounded-xl p-6">
          <p class="font-display text-lg font-semibold text-white">{megaMenu.promo.title}</p>
          <p class="text-columbia-blue text-sm leading-relaxed">{megaMenu.promo.description}</p>
          <Button href={megaMenu.promo.action.href} variant="accent" size="sm" class="mt-auto">
            {megaMenu.promo.action.label}
          </Button>
        </div>
      </Container>
    </div>
  ))}

  <div id="site-menu" class="border-border bg-page hidden border-t lg:hidden">
    <Container class="flex flex-col gap-6 py-6">
      <nav aria-label={labels.mobileNav}>
        <ul class="flex flex-col gap-1 text-lg font-medium">
          {navItems.map((item) =>
            item.kind === 'mega' ? (
              <li>
                <details class="group">
                  <summary class="hover:bg-border flex cursor-pointer list-none items-center justify-between rounded-md px-2 py-2 [&::-webkit-details-marker]:hidden">
                    {item.menu.label}
                    <ChevronDown
                      class="size-5 transition-transform group-open:rotate-180"
                      aria-hidden="true"
                    />
                  </summary>
                  <div class="flex flex-col gap-4 py-2 ps-2">
                    {item.menu.groups.map((group) => (
                      <div class="flex flex-col gap-1">
                        <p class="eyebrow text-muted px-2 py-1">{group.title}</p>
                        <ul class="flex flex-col">
                          {group.entries.map((entry) => (
                            <li>
                              <a
                                href={localize(entry.href)}
                                class="hover:bg-border flex items-center gap-3 rounded-md px-2 py-2 text-base"
                              >
                                <IconChip size="sm">
                                  {entry.kind === 'platform' ? (
                                    <PlatformIcon id={entry.id} />
                                  ) : entry.kind === 'solution' ? (
                                    <SolutionIcon id={entry.id} />
                                  ) : entry.kind === 'resource' ? (
                                    <ResourceIcon id={entry.id} />
                                  ) : (
                                    <MessageCircle />
                                  )}
                                </IconChip>
                                {entry.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </details>
              </li>
            ) : (
              <li>
                <a
                  href={localize(item.link.href)}
                  class="hover:bg-border block rounded-md px-2 py-2"
                >
                  {item.link.label}
                </a>
              </li>
            ),
          )}
        </ul>
      </nav>
      <div class="flex flex-col gap-2 sm:hidden">
        <Button href={localize(actions.signIn.href)} variant="secondary">
          {actions.signIn.label}
        </Button>
        <Button href={localize(actions.bookDemo.href)}>{actions.bookDemo.label}</Button>
      </div>
    </Container>
  </div>
</header>

<script>
  const setMenuOpen = (open: boolean) => {
    const button = document.getElementById('site-menu-button')
    const menu = document.getElementById('site-menu')

    if (!button || !menu) {
      return
    }

    button.setAttribute('aria-expanded', String(open))
    const label = open ? button.dataset.closeLabel : button.dataset.openLabel
    if (label) {
      button.setAttribute('aria-label', label)
    }
    menu.classList.toggle('hidden', !open)
  }

  let megaCloseTimer: number | undefined

  const megaButtons = () => [...document.querySelectorAll<HTMLButtonElement>('[data-mega-button]')]

  const megaPanel = (button: HTMLButtonElement) =>
    document.getElementById(button.getAttribute('aria-controls') ?? '')

  // Opens one dropdown (or none) and closes the others.
  const setMegaOpen = (target: HTMLButtonElement | null) => {
    window.clearTimeout(megaCloseTimer)
    megaButtons().forEach((button) => {
      const open = button === target
      button.setAttribute('aria-expanded', String(open))
      megaPanel(button)?.toggleAttribute('data-open', open)
    })
  }

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') {
      return
    }

    const button = document.getElementById('site-menu-button')
    const openMega = megaButtons().find(
      (megaButton) => megaButton.getAttribute('aria-expanded') === 'true',
    )

    if (button?.getAttribute('aria-expanded') === 'true') {
      setMenuOpen(false)
      button.focus()
    }
    if (openMega) {
      setMegaOpen(null)
      openMega.focus()
    }
  })

  document.addEventListener('click', (event) => {
    const header = document.getElementById('site-header')

    if (event.target instanceof Node && !header?.contains(event.target)) {
      setMegaOpen(null)
    }
  })

  document.addEventListener('astro:page-load', () => {
    const button = document.getElementById('site-menu-button')
    const menu = document.getElementById('site-menu')

    button?.addEventListener('click', () => {
      setMenuOpen(button.getAttribute('aria-expanded') !== 'true')
    })

    menu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenuOpen(false))
    })

    const canHover = window.matchMedia('(hover: hover)').matches

    megaButtons().forEach((megaButton) => {
      const panel = megaPanel(megaButton)

      megaButton.addEventListener('click', (event) => {
        const isOpen = megaButton.getAttribute('aria-expanded') === 'true'
        // A mouse click after hovering keeps the menu open; keyboard and touch toggle it.
        setMegaOpen(canHover && event.detail > 0 ? megaButton : isOpen ? null : megaButton)
      })

      if (canHover) {
        ;[megaButton, panel].forEach((target) => {
          target?.addEventListener('mouseenter', () => setMegaOpen(megaButton))
          target?.addEventListener('mouseleave', () => {
            megaCloseTimer = window.setTimeout(() => setMegaOpen(null), 150)
          })
        })
      }

      panel?.addEventListener('focusout', (event) => {
        if (
          !(event.relatedTarget instanceof Node) ||
          (!panel.contains(event.relatedTarget) && event.relatedTarget !== megaButton)
        ) {
          if (megaButton.getAttribute('aria-expanded') === 'true') {
            setMegaOpen(null)
          }
        }
      })

      panel?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMegaOpen(null))
      })
    })
  })
</script>
