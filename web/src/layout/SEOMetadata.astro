---
import { websiteConfig } from '@/config'
import type { PageMeta } from '@/types'
import { WEBSITE_URL } from 'astro:env/client'
import { SITE_ENV } from 'astro:env/server'

type Props = PageMeta & { lang: string }

const {
  title,
  description,
  image,
  imageAlt,
  noIndex,
  type = 'website',
  publishedTime,
  modifiedTime,
  alternatePaths = [],
} = Astro.props

const canonicalUrl = new URL(Astro.url.pathname, WEBSITE_URL)
const isDefaultImage = !image
const ogImageUrl = image ?? websiteConfig.ogImage.url
const ogImageAlt = imageAlt ?? (isDefaultImage ? websiteConfig.ogImage.alt : title)
const shouldIndex = SITE_ENV === 'production' && !noIndex
---

<title>{title}</title>
{description && <meta name="description" content={description} />}

<meta
  name="robots"
  content={
    shouldIndex
      ? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
      : 'noindex, nofollow'
  }
/>

<link rel="canonical" href={canonicalUrl} />
<link rel="sitemap" href="/sitemap.xml" />

{alternatePaths.map((alternatePath) => (
  <link
    rel="alternate"
    href={`${WEBSITE_URL}${alternatePath.path}`}
    hreflang={alternatePath.hreflang}
  />
))}

<meta property="og:site_name" content={websiteConfig.name} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:locale" content={websiteConfig.locale} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:alt" content={ogImageAlt} />
{isDefaultImage && (
  <>
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(websiteConfig.ogImage.width)} />
    <meta property="og:image:height" content={String(websiteConfig.ogImage.height)} />
  </>
)}
{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{type === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />
