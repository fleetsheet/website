---
import { languages, type Locale } from '@/i18n'
import ChevronDown from '@lucide/astro/icons/chevron-down'

export type Translation = {
  locale: Locale
  href: string
}

type Props = {
  id: string
  locale: Locale
  label: string
  translations: Translation[]
  class?: string
}

const { id, locale, label, translations, class: className } = Astro.props
const current = languages[locale]
const menuId = `${id}-menu`
---

<div class:list={['relative', className]} data-language-switcher>
  <button
    type="button"
    class="text-rich-blue hover:bg-border flex items-center gap-2 rounded-md px-2 py-2 text-[15px] font-medium"
    aria-expanded="false"
    aria-controls={menuId}
    aria-label={`${label}: ${current.name}`}
    data-language-button
  >
    <img
      src={`/flags/${locale}.svg`}
      alt=""
      width="24"
      height="18"
      class="h-[18px] w-6 rounded-xs"
    />
    <span class="hidden xl:inline" lang={current.hreflang}>
      {current.name}
    </span>
    <ChevronDown
      class="size-4 transition-transform in-aria-expanded:rotate-180"
      aria-hidden="true"
    />
  </button>
  <ul
    id={menuId}
    class="bg-surface border-border absolute end-0 top-full z-50 mt-2 hidden min-w-52 flex-col gap-0.5 rounded-xl border p-1.5 shadow-[0_10px_30px_-12px_rgb(15_42_74/0.25)]"
    data-language-menu
  >
    {translations.map((translation) => {
      const language = languages[translation.locale]
      const isCurrent = translation.locale === locale
      return (
        <li>
          <a
            href={translation.href}
            hreflang={language.hreflang}
            lang={language.hreflang}
            aria-current={isCurrent ? 'true' : undefined}
            data-astro-reload
            class="hover:bg-page aria-[current]:bg-page flex items-center gap-3 rounded-md px-3 py-2 text-[15px] aria-[current]:font-semibold"
          >
            <img
              src={`/flags/${translation.locale}.svg`}
              alt=""
              width="24"
              height="18"
              loading="lazy"
              class="h-[18px] w-6 rounded-xs"
            />
            {language.name}
          </a>
        </li>
      )
    })}
  </ul>
</div>

<script>
  const closeAll = (except?: Element) => {
    document.querySelectorAll('[data-language-switcher]').forEach((switcher) => {
      if (switcher === except) {
        return
      }
      switcher.querySelector('[data-language-button]')?.setAttribute('aria-expanded', 'false')
      switcher.querySelector('[data-language-menu]')?.classList.replace('flex', 'hidden')
    })
  }

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || !event.target.closest('[data-language-switcher]')) {
      closeAll()
    }
  })

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') {
      return
    }
    const open = document.querySelector('[data-language-button][aria-expanded="true"]')
    if (open instanceof HTMLElement) {
      closeAll()
      open.focus()
    }
  })

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('[data-language-switcher]').forEach((switcher) => {
      const button = switcher.querySelector('[data-language-button]')
      const menu = switcher.querySelector('[data-language-menu]')

      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') !== 'true'
        closeAll(switcher)
        button.setAttribute('aria-expanded', String(open))
        menu?.classList.toggle('hidden', !open)
        menu?.classList.toggle('flex', open)
      })
    })
  })
</script>
