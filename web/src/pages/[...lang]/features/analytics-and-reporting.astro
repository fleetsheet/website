---
import AnalyticsPage from '@/components/platform/AnalyticsPage.astro'
import { getContent } from '@/data'
import { getLocale, localeStaticPaths } from '@/i18n'
import Layout from '@/layout/Layout.astro'
import type { GetStaticPaths } from 'astro'

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths

const { meta } = getContent(getLocale(Astro.url)).platform.pages.analyticsReporting
---

<Layout meta={meta}>
  <AnalyticsPage />
</Layout>
