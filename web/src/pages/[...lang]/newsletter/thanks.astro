---
import Button from '@/components/ui/Button.astro'
import Container from '@/components/ui/Container.astro'
import { getContent } from '@/data'
import { getLocale, localeStaticPaths } from '@/i18n'
import Layout from '@/layout/Layout.astro'
import type { GetStaticPaths } from 'astro'

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths

const locale = getLocale(Astro.url)
const content = getContent(locale)
const { newsletterThanks } = content.newsletter
---

<Layout meta={{ ...newsletterThanks.meta, noIndex: true }}>
  <Container class="flex flex-col items-center gap-6 py-40 text-center">
    <h1 class="text-display-md">{newsletterThanks.title}</h1>
    <p class="text-azul-blue max-w-md text-[17px]">{newsletterThanks.description}</p>
    <Button href={newsletterThanks.action.href}>{newsletterThanks.action.label}</Button>
  </Container>
</Layout>
