---
import AiAgents from '@/components/home/AiAgents.astro'
import Consultancy from '@/components/home/Consultancy.astro'
import HeroSignalField from '@/components/home/HeroSignalField.astro'
import HomeHero from '@/components/home/HomeHero.astro'
import PlatformModules from '@/components/home/PlatformModules.astro'
import ProductShowcase from '@/components/home/ProductShowcase.astro'
import Solutions from '@/components/home/Solutions.astro'
import UnifiedModel from '@/components/home/UnifiedModel.astro'
import CtaBanner from '@/components/ui/CtaBanner.astro'
import { getContent } from '@/data'
import { getLocale, localeStaticPaths } from '@/i18n'
import Layout from '@/layout/Layout.astro'
import { organizationSchema } from '@/schema/organization'
import { websiteSchema } from '@/schema/website'
import type { GetStaticPaths } from 'astro'
import { Schema } from 'astro-seo-schema'

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths

const locale = getLocale(Astro.url)
const content = getContent(locale)
const { demoCta, meta } = content.home
---

<Layout
  meta={{
    title: meta.title,
    description: meta.description,
  }}
  brand="c"
>
  <!-- The signal field runs behind the hero and the glass product preview. -->
  <div class="relative isolate overflow-hidden bg-black">
    <HeroSignalField />
    <HomeHero />
    <div class="glass-ui">
      <ProductShowcase />
    </div>
  </div>
  <UnifiedModel />
  <PlatformModules />
  <AiAgents />
  <Solutions />
  <Consultancy />
  <CtaBanner
    id="demo"
    title={demoCta.title}
    description={demoCta.description}
    primaryAction={demoCta.primaryAction}
    secondaryAction={content.site.actions.signIn}
  />
  <Schema item={organizationSchema(locale)} />
  <Schema item={websiteSchema(locale)} />
</Layout>
