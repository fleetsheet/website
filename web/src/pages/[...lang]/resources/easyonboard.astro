---
import EasyOnboard from '@/components/resources/EasyOnboard.astro'
import { getContent } from '@/data'
import { getLocale, localeStaticPaths } from '@/i18n'
import Layout from '@/layout/Layout.astro'
import type { GetStaticPaths } from 'astro'

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths

const { meta } = getContent(getLocale(Astro.url)).resources.pages.easyOnboard
---

<Layout meta={meta}>
  <EasyOnboard />
</Layout>
