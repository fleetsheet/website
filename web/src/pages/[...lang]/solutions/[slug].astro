---
import CategoryPage from '@/components/solutions/CategoryPage.astro'
import { getContent } from '@/data'
import { getLocale, localeStaticPaths } from '@/i18n'
import Layout from '@/layout/Layout.astro'
import { categoryPages } from '@/solutions'
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'

export const getStaticPaths = (() =>
  localeStaticPaths().flatMap(({ params }) =>
    categoryPages.map((entry) => ({
      params: { ...params, slug: entry.href.slice('/solutions/'.length) },
      props: { id: entry.id },
    })),
  )) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { id } = Astro.props
const { meta } = getContent(getLocale(Astro.url)).solutions.pages[id]
---

<Layout meta={meta}>
  <CategoryPage page={id} />
</Layout>
