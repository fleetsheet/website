---
import Button from '@/components/ui/Button.astro'
import Container from '@/components/ui/Container.astro'
import Layout from '@/layout/Layout.astro'
import { VERCEL_ENV } from 'astro:env/server'
import House from '@lucide/astro/icons/house'

const isProductionDeployment = VERCEL_ENV === 'production'
---

<Layout
  meta={{
    title: 'Page not found | Fleet',
    description: 'The page you are looking for does not exist or has moved.',
    noIndex: true,
  }}
>
  <Container class="flex flex-col items-center gap-6 py-40 text-center">
    <p class="eyebrow text-azul-blue">Error 404</p>
    <h1 class="text-display-md">Page not found</h1>
    <p class="text-azul-blue max-w-md text-[17px]">
      The page you are looking for does not exist or has moved.
    </p>
    <Button href="/">
      <House class="size-4" aria-hidden="true" />
      Back to home
    </Button>
  </Container>

  {isProductionDeployment && (
    <script
      is:inline
      set:html={`
          document.addEventListener('DOMContentLoaded', function () {
            plausible('404', {
              props: {
                path: document.location.pathname,
                userAgent: navigator.userAgent,
                referrer: document.referrer,
              },
            });
          });
        `}
    ></script>
  )}
</Layout>
