---
import PageSection from '@/components/ui/PageSection.astro'
import SectionHeader from '@/components/ui/SectionHeader.astro'
import { websiteConfig } from '@/config'
import Layout from '@/layout/Layout.astro'
import { formatDate } from '@/utils/formatDate'
import { getPublishedInsights } from '@/utils/insights'

const insights = await getPublishedInsights()
---

<Layout
  meta={{
    title: `Insights | ${websiteConfig.name}`,
    description: 'News, guides and ideas from the Fleet team.',
  }}
>
  <PageSection>
    <SectionHeader eyebrow="Insights" title="Insights" />
    <ul class="mt-12 flex flex-col gap-6">
      {insights.map((insight) => (
        <li class="border-border bg-surface rounded-xl border p-6">
          <a href={`/insights/${insight.id}`} class="flex flex-col gap-2">
            <p class="text-muted text-sm">
              <time datetime={insight.data.publishedAt.toISOString()}>
                {formatDate(insight.data.publishedAt)}
              </time>
              {insight.data.category && <span> · {insight.data.category}</span>}
            </p>
            <h2 class="text-rich-blue text-xl font-semibold">{insight.data.title}</h2>
            <p class="text-azul-blue">{insight.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </PageSection>
</Layout>
