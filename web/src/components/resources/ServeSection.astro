---
import Container from '@/components/ui/Container.astro'
import IconChip from '@/components/ui/IconChip.astro'
import { getContent } from '@/data'
import { getLocale, localizePath } from '@/i18n'
import ArrowRight from '@lucide/astro/icons/arrow-right'
import Building from '@lucide/astro/icons/building'
import GraduationCap from '@lucide/astro/icons/graduation-cap'
import Landmark from '@lucide/astro/icons/landmark'
import ShoppingBag from '@lucide/astro/icons/shopping-bag'
import Truck from '@lucide/astro/icons/truck'

// "Who we serve": the sectors Fleet works with, shared by Customer Stories and Company Story.
const locale = getLocale(Astro.url)
const { serve } = getContent(locale).resources.customerStories
const localize = (href: string) => localizePath(href, locale)
const serveIcons = [Building, Truck, GraduationCap, ShoppingBag, Landmark]
---

<section class="bg-surface border-border border-y">
  <Container class="flex flex-col gap-10 py-16 lg:py-14">
    <div class="flex max-w-[720px] flex-col gap-4">
      <h2 class="text-display-md hyphenate">{serve.title}</h2>
      <p class="text-azul-blue text-[17px] leading-[1.65]">{serve.description}</p>
    </div>
    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {serve.items.map((item, index) => {
        const Icon = serveIcons[index % serveIcons.length]
        return (
          <li>
            <a
              href={localize(item.href)}
              class="group border-border hover:border-celestial-blue bg-page flex h-full flex-col gap-3 rounded-xl border p-5 transition-colors"
            >
              <IconChip>
                <Icon />
              </IconChip>
              <span class="text-rich-blue font-semibold">{item.label}</span>
              <span class="text-azul-blue text-sm">{item.detail}</span>
              <ArrowRight
                class="text-celestial-blue mt-auto size-4 transition-transform group-hover:translate-x-1 rtl:-scale-x-100 rtl:group-hover:-translate-x-1"
                aria-hidden="true"
              />
            </a>
          </li>
        )
      })}
    </ul>
  </Container>
</section>
