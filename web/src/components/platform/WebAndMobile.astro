---
import Button from '@/components/ui/Button.astro'
import CheckList from '@/components/ui/CheckList.astro'
import Container from '@/components/ui/Container.astro'
import CtaBanner from '@/components/ui/CtaBanner.astro'
import IconChip from '@/components/ui/IconChip.astro'
import PageSection from '@/components/ui/PageSection.astro'
import SectionHeader from '@/components/ui/SectionHeader.astro'
import { getContent } from '@/data'
import { getLocale } from '@/i18n'
import ArrowRight from '@lucide/astro/icons/arrow-right'
import Check from '@lucide/astro/icons/check'
import Quote from '@lucide/astro/icons/quote'
import Wifi from '@lucide/astro/icons/wifi'
import AudienceColumns from './AudienceColumns.astro'
import DeviceShowcase from './DeviceShowcase.astro'
import OverviewVisual from './OverviewVisual.astro'

const { webMobile, overview, cta } = getContent(getLocale(Astro.url)).platform
const { hero, audiences, rows, field, stories } = webMobile
---

<section>
  <Container class="flex flex-col items-center gap-6 pt-20 pb-14 text-center">
    <p class="eyebrow text-azul-blue">{hero.eyebrow}</p>
    <h1 class="text-display-xl hyphenate max-w-[900px]">{hero.title}</h1>
    <p class="text-lead text-azul-blue max-w-[680px] text-pretty">{hero.description}</p>
    <Button href={hero.primaryAction.href}>
      {hero.primaryAction.label}
      <ArrowRight class="size-4 rtl:-scale-x-100" aria-hidden="true" />
    </Button>
    <ul class="text-azul-blue flex flex-wrap justify-center gap-5 text-sm">
      {hero.highlights.map((highlight) => (
        <li class="flex items-center gap-1.5">
          <Check class="text-celestial-blue size-4" aria-hidden="true" />
          {highlight}
        </li>
      ))}
    </ul>
  </Container>
</section>

<DeviceShowcase />

<PageSection tone="surface" containerClass="flex flex-col gap-12">
  <div class="grid grid-cols-1 items-end gap-6 lg:grid-cols-2 lg:gap-16">
    <SectionHeader eyebrow={audiences.eyebrow} title={audiences.title} />
    <p class="text-azul-blue text-[17px] leading-[1.65] text-pretty">{audiences.description}</p>
  </div>
  <AudienceColumns items={overview.audiences.items} />
</PageSection>

<PageSection containerClass="flex flex-col gap-24">
  {rows.map((row, index) => (
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-20">
      <div class:list={['flex flex-col items-start gap-5', index % 2 === 1 && 'lg:order-2']}>
        <SectionHeader eyebrow={row.tag} title={row.title} description={row.description} />
        <CheckList items={row.points} class="gap-3" />
      </div>
      <OverviewVisual visual={row.visual} />
    </div>
  ))}
</PageSection>

<section>
  <Container width="wide" class="pb-24">
    <div class="bg-azul-blue grid grid-cols-1 items-center gap-8 rounded-2xl p-[clamp(32px,5vw,64px)] lg:grid-cols-[1fr_auto]">
      <SectionHeader
        eyebrow={field.eyebrow}
        title={field.title}
        description={field.description}
        tone="dark"
      />
      <IconChip tone="dark" class="size-24 rounded-2xl [&>svg]:size-12">
        <Wifi />
      </IconChip>
    </div>
  </Container>
</section>

<PageSection tone="inverse" containerClass="flex flex-col gap-12">
  <SectionHeader eyebrow={stories.eyebrow} title={stories.title} tone="dark" />
  <ul class="grid grid-cols-1 gap-5 md:grid-cols-2">
    {stories.items.map((story) => (
      <li class="bg-azul-blue flex flex-col gap-6 rounded-xl p-8">
        <Quote class="text-sky-blue size-8 rtl:-scale-x-100" aria-hidden="true" />
        <blockquote class="text-alice-blue font-display text-xl leading-snug font-medium">
          {story.quote}
        </blockquote>
        <p class="mt-auto text-sm">
          <span class="block font-semibold text-white">{story.author}</span>
          <span class="text-columbia-blue">{story.company}</span>
        </p>
      </li>
    ))}
  </ul>
</PageSection>

<CtaBanner
  title={cta.title}
  description={cta.description}
  primaryAction={cta.primaryAction}
  secondaryAction={cta.secondaryAction}
/>
