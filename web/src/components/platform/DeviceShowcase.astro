---
import devicesPhoto from '@/assets/brand/fleet-devices.webp'
import { Image } from 'astro:assets'
---

<!--
  Fleet on a laptop, phone, desktop and tablet: a supplied product photograph,
  full width, fading in from the dark hero above it.
-->
<section aria-hidden="true">
  <Image
    src={devicesPhoto}
    alt=""
    widths={[640, 1024, 1440, 2000]}
    sizes="100vw"
    class="block h-auto w-full -mt-px mask-[linear-gradient(to_bottom,transparent,black_30%)]"
  />
</section>
