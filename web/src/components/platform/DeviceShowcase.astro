---
import devicesPhoto from '@/assets/brand/fleet-devices.webp'
import Container from '@/components/ui/Container.astro'
import { Image } from 'astro:assets'
---

<!-- Fleet on a laptop, phone, desktop and tablet: a supplied product photograph. -->
<section aria-hidden="true">
  <Container width="wide" class="pt-16 pb-20">
    <Image
      src={devicesPhoto}
      alt=""
      widths={[640, 1024, 1440, 2000]}
      sizes="(min-width: 1280px) 1248px, 100vw"
      class="h-auto w-full rounded-3xl shadow-lg"
    />
  </Container>
</section>
