---
import Container from '@/components/ui/Container.astro'
import ChevronDown from '@lucide/astro/icons/chevron-down'

type Props = {
  title: string
  items: { question: string; answer: string }[]
}

const { title, items } = Astro.props
---

<section>
  <Container class="grid grid-cols-1 gap-10 pt-16 lg:grid-cols-[1fr_2fr]">
    <h2 class="text-display-md">{title}</h2>
    <ul class="flex flex-col gap-3">
      {items.map((item) => (
        <li>
          <details class="group border-border bg-surface rounded-xl border shadow-xs">
            <summary class="text-rich-blue flex cursor-pointer list-none items-center justify-between gap-4 p-6 text-lg font-semibold [&::-webkit-details-marker]:hidden">
              <span>{item.question}</span>
              <ChevronDown
                aria-hidden="true"
                class="text-azul-blue size-5 shrink-0 transition-transform group-open:rotate-180"
              />
            </summary>
            <p class="text-azul-blue px-6 pb-6 leading-relaxed">{item.answer}</p>
          </details>
        </li>
      ))}
    </ul>
  </Container>
</section>
