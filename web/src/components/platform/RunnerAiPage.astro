---
import Button from '@/components/ui/Button.astro'
import CheckList from '@/components/ui/CheckList.astro'
import Container from '@/components/ui/Container.astro'
import CtaBanner from '@/components/ui/CtaBanner.astro'
import IconChip from '@/components/ui/IconChip.astro'
import MockPanel from '@/components/ui/MockPanel.astro'
import PageSection from '@/components/ui/PageSection.astro'
import SectionHeader from '@/components/ui/SectionHeader.astro'
import { getContent } from '@/data'
import type { RunnerAiIcon } from '@/data/en/platform'
import { getLocale } from '@/i18n'
import ArrowRight from '@lucide/astro/icons/arrow-right'
import ArrowUp from '@lucide/astro/icons/arrow-up'
import ChartColumn from '@lucide/astro/icons/chart-column'
import Database from '@lucide/astro/icons/database'
import FileCheck from '@lucide/astro/icons/file-check'
import ListChecks from '@lucide/astro/icons/list-checks'
import LockKeyhole from '@lucide/astro/icons/lock-keyhole'
import Server from '@lucide/astro/icons/server'
import ShieldCheck from '@lucide/astro/icons/shield-check'
import Sparkles from '@lucide/astro/icons/sparkles'
import Workflow from '@lucide/astro/icons/workflow'
import ChallengeCards from './ChallengeCards.astro'
import FeatureBanner from './FeatureBanner.astro'
import FeatureRows from './FeatureRows.astro'
import IndustriesIntegrate from './IndustriesIntegrate.astro'
import OverviewVisual from './OverviewVisual.astro'
import StepsBand from './StepsBand.astro'

const { runnerAiPage, cta } = getContent(getLocale(Astro.url)).platform
const { hero, challenge, capabilities, steps, rows, rules, security, industries, integrate } =
  runnerAiPage
const tabIcons = {
  data: Database,
  tasks: ListChecks,
  workflows: Workflow,
  dashboards: ChartColumn,
} satisfies Record<RunnerAiIcon, unknown>
const securityIcons = [Server, LockKeyhole, FileCheck, ShieldCheck]
const stepStyles = [
  'bg-columbia-blue text-azul-blue',
  'bg-cream-peach text-cream-peach-foreground',
  'bg-rich-blue text-alice-blue',
]
---

<section class="bg-rich-blue text-alice-blue">
  <Container class="grid grid-cols-1 items-center gap-12 py-20 lg:grid-cols-[1fr_1.05fr] lg:py-24">
    <div class="flex flex-col items-start gap-6">
      <p class="eyebrow text-sky-blue flex items-center gap-2.5">
        <IconChip size="sm" tone="dark">
          <Sparkles />
        </IconChip>
        {hero.eyebrow}
      </p>
      <h1 class="text-display-xl hyphenate text-white">{hero.title}</h1>
      <p class="text-lead text-columbia-blue text-pretty">{hero.description}</p>
      <div class="flex flex-wrap gap-3">
        <Button href={hero.primaryAction.href} variant="accent">
          {hero.primaryAction.label}
          <ArrowRight class="size-4 rtl:-scale-x-100" aria-hidden="true" />
        </Button>
        <Button href={hero.secondaryAction.href} variant="inverse">
          {hero.secondaryAction.label}
        </Button>
      </div>
    </div>
    <div aria-hidden="true">
      <MockPanel elevation="float" padding="none" class="text-rich-blue overflow-hidden">
        <div class="border-border flex items-center gap-2.5 border-b px-4 py-3">
          <IconChip size="sm">
            <Sparkles />
          </IconChip>
          <p class="font-display text-sm font-semibold">{hero.demo.title}</p>
          <span class="text-muted ms-auto text-xs">{hero.demo.context}</span>
        </div>
        <div class="flex flex-col gap-4 p-5">
          <p class="bg-rich-blue text-alice-blue max-w-[85%] self-end rounded-lg px-3.5 py-2.5 text-sm leading-[1.5]">
            {hero.demo.prompt}
          </p>
          <div class="flex flex-col gap-3">
            <p class="text-sm font-semibold">{hero.demo.reply}</p>
            <div class="flex flex-col">
              {hero.demo.steps.map((step, index) => (
                <div class="flex flex-col items-start">
                  <div class="bg-surface border-border flex w-full items-center gap-2.5 rounded-md border px-3 py-2.5 text-[13px] shadow-xs">
                    <span
                      class:list={[
                        'rounded-sm px-1.5 py-0.5 text-[10px] font-bold tracking-[0.04em] uppercase',
                        stepStyles[index % stepStyles.length],
                      ]}
                    >
                      {step.kind}
                    </span>
                    <span class="font-semibold">{step.text}</span>
                  </div>
                  {index < hero.demo.steps.length - 1 && (
                    <div class="bg-uranian-blue ms-6 h-3 w-0.5" />
                  )}
                </div>
              ))}
            </div>
            <span class="bg-rich-blue text-alice-blue flex items-center gap-2 self-start rounded-md px-3 py-2 text-xs font-semibold">
              <ArrowUp class="size-3.5" />
              {hero.demo.action}
            </span>
          </div>
        </div>
      </MockPanel>
    </div>
  </Container>
</section>

<ChallengeCards pressure={challenge.pressure} answer={challenge.answer} />

<PageSection tone="surface" containerClass="flex flex-col gap-10">
  <SectionHeader title={capabilities.title} description={capabilities.description} />
  <div
    role="tablist"
    aria-label={capabilities.title}
    class="border-border grid grid-cols-2 gap-2 border-b pb-4 sm:grid-cols-4"
    data-runner-tabs
  >
    {capabilities.tabs.map((tab, index) => {
      const Icon = tabIcons[tab.icon]
      return (
        <button
          type="button"
          role="tab"
          id={`runner-tab-${index}`}
          aria-controls={`runner-panel-${index}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          class="text-azul-blue hover:bg-page aria-selected:bg-rich-blue aria-selected:text-alice-blue flex items-center justify-center gap-2 rounded-lg px-4 py-3 text-[15px] font-semibold transition-colors"
        >
          <Icon class="size-[18px]" aria-hidden="true" />
          {tab.label}
        </button>
      )
    })}
  </div>
  {capabilities.tabs.map((tab, index) => (
    <div
      role="tabpanel"
      id={`runner-panel-${index}`}
      aria-labelledby={`runner-tab-${index}`}
      hidden={index !== 0}
      class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16"
    >
      <div class="flex flex-col gap-5">
        <h3 class="text-display-md">{tab.title}</h3>
        <p class="text-azul-blue text-[17px] leading-[1.65]">{tab.description}</p>
        <CheckList items={tab.points} class="gap-3" />
      </div>
      <OverviewVisual visual={tab.visual} />
    </div>
  ))}
</PageSection>

<StepsBand eyebrow={steps.eyebrow} title={steps.title} items={steps.items} />

<FeatureRows rows={rows} />

<FeatureBanner
  eyebrow={rules.eyebrow}
  title={rules.title}
  description={rules.description}
  action={rules.action}
/>

<PageSection tone="inverse" containerClass="flex flex-col gap-12">
  <SectionHeader
    eyebrow={security.eyebrow}
    title={security.title}
    description={security.description}
    tone="dark"
    align="center"
  />
  <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {security.items.map((item, index) => {
      const Icon = securityIcons[index % securityIcons.length]
      return (
        <li class="bg-azul-blue flex flex-col items-center gap-3 rounded-xl p-6 text-center">
          <IconChip size="lg" tone="dark">
            <Icon />
          </IconChip>
          <h3 class="text-lg font-semibold text-white">{item.title}</h3>
          <p class="text-columbia-blue text-[15px] leading-[1.55]">{item.description}</p>
        </li>
      )
    })}
  </ul>
</PageSection>

<IndustriesIntegrate industries={industries} integrate={integrate} />

<CtaBanner
  title={cta.title}
  description={cta.description}
  primaryAction={cta.primaryAction}
  secondaryAction={cta.secondaryAction}
/>

<script>
  document.addEventListener('astro:page-load', () => {
    const list = document.querySelector('[data-runner-tabs]')
    if (!list) {
      return
    }
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')]

    const select = (next: HTMLButtonElement) => {
      tabs.forEach((tab) => {
        const selected = tab === next
        tab.setAttribute('aria-selected', String(selected))
        tab.tabIndex = selected ? 0 : -1
        const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '')
        if (panel) {
          panel.hidden = !selected
        }
      })
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab))
      tab.addEventListener('keydown', (event) => {
        const rtl = document.documentElement.dir === 'rtl'
        const forward = rtl ? 'ArrowLeft' : 'ArrowRight'
        const back = rtl ? 'ArrowRight' : 'ArrowLeft'
        let target: HTMLButtonElement | undefined
        if (event.key === forward) {
          target = tabs[(index + 1) % tabs.length]
        } else if (event.key === back) {
          target = tabs[(index - 1 + tabs.length) % tabs.length]
        } else if (event.key === 'Home') {
          target = tabs[0]
        } else if (event.key === 'End') {
          target = tabs[tabs.length - 1]
        }
        if (target) {
          event.preventDefault()
          select(target)
          target.focus()
        }
      })
    })
  })
</script>
