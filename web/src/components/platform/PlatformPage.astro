---
import Button from '@/components/ui/Button.astro'
import CheckList from '@/components/ui/CheckList.astro'
import Container from '@/components/ui/Container.astro'
import CtaBanner from '@/components/ui/CtaBanner.astro'
import IconChip from '@/components/ui/IconChip.astro'
import MockPanel from '@/components/ui/MockPanel.astro'
import PageSection from '@/components/ui/PageSection.astro'
import SectionHeader from '@/components/ui/SectionHeader.astro'
import { getContent } from '@/data'
import { getLocale, localizePath } from '@/i18n'
import { platformGroups, platformPages, type PlatformPageId } from '@/platform'
import ArrowRight from '@lucide/astro/icons/arrow-right'
import Check from '@lucide/astro/icons/check'
import PlatformIcon from './PlatformIcon.astro'

type Props = {
  id: PlatformPageId
}

const { id } = Astro.props
const locale = getLocale(Astro.url)
const { pages, pageActions, sectionLabels, menu, cta } = getContent(locale).platform
const page = pages[id]
const current = platformPages.find((entry) => entry.id === id)
const relatedGroups = platformGroups
  .filter((group) => id === 'overview' || group === current?.group)
  .map((group) => ({
    title: menu.groups[group],
    entries: platformPages.filter((entry) => entry.group === group && entry.id !== id),
  }))
---

<section>
  <Container class="grid items-center gap-12 pt-20 pb-16 lg:grid-cols-[1.1fr_1fr]">
    <div class="flex flex-col items-start gap-6">
      <p class="eyebrow text-azul-blue flex items-center gap-2.5">
        <IconChip size="sm">
          <PlatformIcon id={id} />
        </IconChip>
        {page.eyebrow}
      </p>
      <h1 class="text-display-xl">{page.title}</h1>
      <p class="text-lead text-azul-blue text-pretty">{page.description}</p>
      <div class="flex flex-wrap gap-3">
        <Button href={pageActions.primary.href}>
          {pageActions.primary.label}
          <ArrowRight class="size-4 rtl:-scale-x-100" aria-hidden="true" />
        </Button>
        {id !== 'overview' && (
          <Button href={pageActions.secondary.href} variant="secondary">
            {pageActions.secondary.label}
          </Button>
        )}
      </div>
    </div>
    <MockPanel elevation="float" class="flex flex-col gap-5 p-6">
      <div class="flex items-center gap-3">
        <IconChip size="lg">
          <PlatformIcon id={id} />
        </IconChip>
        <p class="font-display text-lg font-semibold">{page.label}</p>
      </div>
      <p class="text-azul-blue text-[15px] leading-[1.55]">{page.summary}</p>
      <ul class="border-border flex flex-col divide-y divide-(--color-border) border-t">
        {page.highlights.map((highlight) => (
          <li class="flex items-center gap-3 py-3 text-[15px] font-medium">
            <span class="bg-columbia-blue text-celestial-blue flex size-6 items-center justify-center rounded-full">
              <Check class="size-3.5" stroke-width={3} aria-hidden="true" />
            </span>
            {highlight}
          </li>
        ))}
      </ul>
    </MockPanel>
  </Container>
</section>

<PageSection tone="surface" containerClass="flex flex-col gap-12">
  <SectionHeader
    eyebrow={sectionLabels.features}
    title={page.features.title}
    description={page.features.description}
  />
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {page.features.items.map((item) => (
      <li class="bg-page border-border flex flex-col gap-3 rounded-xl border p-6">
        <IconChip>
          <Check stroke-width={2.5} />
        </IconChip>
        <h3 class="font-display text-[19px] font-semibold tracking-[-0.01em]">{item.title}</h3>
        <p class="text-azul-blue text-[15px] leading-[1.55]">{item.description}</p>
      </li>
    ))}
  </ul>
</PageSection>

<PageSection containerClass="flex flex-col gap-20">
  {page.details.map((detail, index) => (
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <SectionHeader
        title={detail.title}
        description={detail.description}
        class:list={[index % 2 === 1 && 'lg:order-2']}
      />
      <MockPanel class="p-6 sm:p-8">
        <CheckList items={detail.points} class="text-rich-blue gap-4" />
      </MockPanel>
    </div>
  ))}
</PageSection>

<PageSection tone="inverse" containerClass="grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
  <SectionHeader
    eyebrow={sectionLabels.useCases}
    title={page.useCases.title}
    description={page.useCases.description}
    tone="dark"
  />
  <ol class="flex flex-col gap-3">
    {page.useCases.items.map((item, index) => (
      <li class="bg-azul-blue flex items-start gap-4 rounded-xl p-5">
        <span class="font-display bg-rich-blue text-sky-blue flex size-7 shrink-0 items-center justify-center rounded-md text-[13px] font-semibold">
          {index + 1}
        </span>
        <span class="text-alice-blue pt-0.5 text-[15px] leading-[1.55]">{item}</span>
      </li>
    ))}
  </ol>
</PageSection>

<PageSection containerClass="flex flex-col gap-10">
  <SectionHeader eyebrow={sectionLabels.related} title={sectionLabels.relatedTitle} />
  {relatedGroups.map((group) => (
    <div class="flex flex-col gap-4">
      {relatedGroups.length > 1 && <h3 class="text-lg font-semibold">{group.title}</h3>}
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {group.entries.map((entry) => (
          <li>
            <a
              href={localizePath(entry.href, locale)}
              class="group bg-surface border-border hover:border-celestial-blue flex h-full flex-col gap-3 rounded-xl border p-6 shadow-xs transition-colors"
            >
              <IconChip>
                <PlatformIcon id={entry.id} />
              </IconChip>
              <span class="font-display text-rich-blue text-lg font-semibold">
                {pages[entry.id].label}
              </span>
              <span class="text-azul-blue text-[15px] leading-[1.55]">
                {pages[entry.id].summary}
              </span>
              <span class="text-celestial-blue mt-auto flex items-center gap-1.5 text-sm font-semibold">
                {sectionLabels.learnMore}
                <ArrowRight
                  class="size-4 transition-transform group-hover:translate-x-0.5 rtl:-scale-x-100 rtl:group-hover:-translate-x-0.5"
                  aria-hidden="true"
                />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</PageSection>

<CtaBanner
  title={cta.title}
  description={cta.description}
  primaryAction={cta.primaryAction}
  secondaryAction={cta.secondaryAction}
/>
