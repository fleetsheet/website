---
import OverviewVisual from '@/components/platform/OverviewVisual.astro'
import type { OverviewVisual as Visual } from '@/data/en/platform'
import type Workflow from '@lucide/astro/icons/workflow'

type Props = {
  main: Visual
  back?: Visual
  front?: Visual
  icons: (typeof Workflow)[]
}

const { main, back, front, icons } = Astro.props
const [FirstIcon, SecondIcon, ThirdIcon] = icons
const chip = 'bg-surface text-azul-blue shadow-float absolute z-40 hidden rounded-xl p-3 lg:block'
---

<!-- Layered product composition: the main card leads, supporting cards and feature icons frame it. -->
<div class="relative">
  <div class="lg:hidden">
    <OverviewVisual visual={main} />
  </div>
  <div class="relative hidden h-[690px] lg:block" aria-hidden="true">
    <div class="bg-supergraphic absolute inset-y-14 start-16 end-6 rounded-3xl"></div>
    {back && (
      <div class="absolute start-0 top-0 z-10 w-[46%]">
        <OverviewVisual visual={back} />
      </div>
    )}
    <div class="absolute end-0 top-[118px] z-20 w-[62%]">
      <OverviewVisual visual={main} />
    </div>
    {front && (
      <div class="absolute start-[6%] bottom-0 z-30 w-[50%]">
        <OverviewVisual visual={front} />
      </div>
    )}
    {FirstIcon && (
      <span class:list={[chip, 'end-24 top-6']}>
        <FirstIcon class="size-6" />
      </span>
    )}
    {SecondIcon && (
      <span class:list={[chip, 'bg-rich-blue! text-sky-blue! end-2 bottom-24']}>
        <SecondIcon class="size-6" />
      </span>
    )}
    {ThirdIcon && (
      <span class:list={[chip, 'start-6 top-[48%]']}>
        <ThirdIcon class="size-6" />
      </span>
    )}
  </div>
</div>
