---
/**
 * Work Order hero background: a project timeline. Rows of task bars, some
 * light, some dark glass and some with a glowing steel fill, drift slowly from
 * start to end across a very subtle grid, with the odd milestone diamond and
 * day marker riding along. Each row moves at its own pace. The copy side stays
 * quiet; the glass preview blurs the bars behind it.
 *
 * Pure CSS motion; everything holds still for reduced motion.
 */

type Bar = { width: number; gap: number; tone: 'light' | 'dark' | 'glow' | 'milestone' }
type Row = { top: number; duration: number; offset: number; bars: Bar[] }

let seed = 23
const random = () => {
  seed = (seed * 16807) % 2147483647
  return (seed - 1) / 2147483646
}
const pick = (min: number, max: number) => min + Math.floor(random() * (max - min + 1))
const tones: Bar['tone'][] = ['dark', 'light', 'dark', 'glow', 'dark', 'milestone']

const rows: Row[] = Array.from({ length: 7 }, (_, index) => ({
  top: 9 + index * 13,
  duration: pick(70, 120),
  offset: -pick(0, 60),
  bars: Array.from({ length: 6 }, () => {
    const tone = tones[pick(0, tones.length - 1)]
    return {
      width: tone === 'milestone' ? 28 : pick(120, 320),
      gap: pick(24, 90),
      tone,
    }
  }),
}))
---

<div class="timeline-field" aria-hidden="true">
  <div class="timeline-grid"></div>
  {rows.map((row) => (
    <div
      class="timeline-row"
      style={`top: ${row.top}%; --duration: ${row.duration}s; --offset: ${row.offset}s`}
    >
      {[0, 1].map(() => (
        <div class="timeline-set">
          {row.bars.map((bar) => (
            <span
              class:list={['bar', bar.tone]}
              style={`width: ${bar.width}px; margin-inline-end: ${bar.gap}px`}
            >
              {bar.tone !== 'milestone' && <span class="chip" />}
            </span>
          ))}
        </div>
      ))}
    </div>
  ))}
  <div class="timeline-quiet"></div>
</div>

<style>
  .timeline-field {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    mask-image: linear-gradient(to bottom, transparent, black 10%, black 88%, transparent);
  }

  /* A very subtle grid behind the bars. */
  .timeline-grid {
    position: absolute;
    inset: 0;
    --line: color-mix(in srgb, var(--color-steel) 10%, transparent);

    background-image:
      linear-gradient(to right, var(--line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--line) 1px, transparent 1px);
    background-size: 64px 64px;
  }

  .timeline-row {
    position: absolute;
    opacity: 0.7;
    inset-inline-start: 0;
    display: flex;
    width: max-content;
    animation: timeline-drift var(--duration) linear var(--offset) infinite;
  }

  .timeline-set {
    display: flex;
    align-items: center;
  }

  .bar {
    position: relative;
    display: flex;
    height: 36px;
    flex-shrink: 0;
    align-items: center;
    justify-content: flex-end;
    padding-inline: 10px;
    border-radius: 10px;
  }

  .bar.dark {
    border: 1px solid color-mix(in srgb, var(--color-cream) 10%, transparent);
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-navy-dusk) 75%, transparent),
      color-mix(in srgb, var(--color-navy-night) 75%, transparent)
    );
  }

  .bar.light {
    background: color-mix(in srgb, var(--color-steel-soft) 35%, transparent);
  }

  .bar.glow {
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--color-steel) 75%, transparent),
      color-mix(in srgb, var(--color-navy) 70%, transparent) 55%,
      color-mix(in srgb, var(--color-navy-night) 60%, transparent)
    );
    box-shadow: 0 0 24px color-mix(in srgb, var(--color-steel) 30%, transparent);
  }

  .bar.milestone {
    width: 22px !important;
    height: 22px;
    padding: 0;
    rotate: 45deg;
    border: 1px solid color-mix(in srgb, var(--color-cream) 18%, transparent);
    border-radius: 5px;
    background: var(--color-navy-dusk);
  }

  /* The day marker at the end of each bar. */
  .chip {
    width: 34px;
    height: 14px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--color-cream) 55%, transparent);
  }

  .bar.light .chip {
    background: var(--color-navy-deep);
  }

  /* Quiet behind the copy on the start side. */
  .timeline-quiet {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--color-black) 96%, transparent) 30%,
      color-mix(in srgb, var(--color-black) 60%, transparent) 50%,
      transparent 68%
    );
  }

  :global([dir='rtl']) .timeline-quiet {
    background: linear-gradient(
      to left,
      color-mix(in srgb, var(--color-black) 96%, transparent) 30%,
      color-mix(in srgb, var(--color-black) 60%, transparent) 50%,
      transparent 68%
    );
  }

  :global([dir='rtl']) .timeline-row {
    animation-direction: reverse;
  }

  @media (max-width: 63.99rem) {
    .timeline-quiet,
    :global([dir='rtl']) .timeline-quiet {
      background: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--color-black) 85%, transparent) 30%,
        color-mix(in srgb, var(--color-black) 40%, transparent) 55%,
        transparent 75%
      );
    }
  }

  /* Each row carries two identical sets, so sliding one set's width loops
     seamlessly; the bars move from start to end. */
  @keyframes timeline-drift {
    from {
      translate: -50% 0;
    }

    to {
      translate: 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-row {
      animation: none;
      translate: -25% 0;
    }
  }
</style>
