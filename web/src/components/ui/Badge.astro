---
export type BadgeTone = 'due' | 'overdue' | 'done' | 'info' | 'neutral'

type Props = {
  tone?: BadgeTone
  class?: string
}

const { tone = 'info', class: className } = Astro.props
---

<span
  class:list={[
    // Palette C: 28px labelled status pills with a 6px dot, in the exact status palette.
    "inline-flex h-7 items-center gap-1.5 rounded-full px-3 text-[13px] font-medium whitespace-nowrap before:size-1.5 before:rounded-full before:bg-current before:content-['']",
    {
      'bg-status-progress text-black': tone === 'due',
      'bg-status-urgent text-cream': tone === 'overdue',
      'bg-status-done text-black': tone === 'done',
      'bg-status-open text-black': tone === 'info',
      'border-border text-rich-blue border bg-transparent brand-c:border-hairline brand-c:text-cream on-light:border-hairline-light on-light:text-black':
        tone === 'neutral',
    },
    className,
  ]}
>
  <slot />
</span>
