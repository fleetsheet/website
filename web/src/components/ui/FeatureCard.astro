---
type Props = {
  title: string
  description: string
  class?: string
}

const { title, description, class: className } = Astro.props
---

<article
  class:list={['bg-page border-border flex flex-col gap-5 rounded-xl border p-6', className]}
>
  <div class="flex flex-col gap-1.5">
    <h3 class="font-display text-[19px] font-semibold tracking-[-0.01em]">{title}</h3>
    <p class="text-azul-blue text-[15px] leading-[1.55]">{description}</p>
  </div>
  <div class="mt-auto" aria-hidden="true">
    <slot />
  </div>
</article>
