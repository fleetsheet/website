---
type Props = {
  size?: 'sm' | 'md' | 'lg'
  tone?: 'light' | 'dark'
  class?: string
}

const { size = 'md', tone = 'light', class: className } = Astro.props
---

<span
  aria-hidden="true"
  class:list={[
    'flex shrink-0 items-center justify-center rounded-md',
    {
      'size-7 [&>svg]:size-[15px]': size === 'sm',
      'size-8 [&>svg]:size-4': size === 'md',
      'size-9 [&>svg]:size-[18px]': size === 'lg',
    },
    tone === 'light' ? 'bg-columbia-blue text-celestial-blue' : 'bg-azul-blue text-sky-blue',
    className,
  ]}
>
  <slot />
</span>
