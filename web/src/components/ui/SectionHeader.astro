---
type Props = {
  eyebrow?: string
  title: string
  description?: string
  tone?: 'light' | 'dark'
  align?: 'start' | 'center'
  class?: string
}

const {
  eyebrow,
  title,
  description,
  tone = 'light',
  align = 'start',
  class: className,
} = Astro.props
---

<div
  class:list={[
    'flex max-w-[720px] flex-col gap-4',
    align === 'center' && 'mx-auto items-center text-center',
    className,
  ]}
>
  {eyebrow && (
    <p
      class:list={[
        'eyebrow brand-c:text-[11px] brand-c:font-medium brand-c:tracking-[0.08em] brand-c:text-steel on-light:text-slate-ink on-steel:text-navy-deep',
        tone === 'light' ? 'text-azul-blue' : 'text-sky-blue',
      ]}
    >
      {eyebrow}
    </p>
  )}
  <h2
    class:list={[
      'text-display-md brand-c:text-cream on-light:text-black on-steel:text-black',
      tone === 'light' ? 'text-rich-blue' : 'text-white',
    ]}
  >
    {title}
  </h2>
  {description && (
    <p
      class:list={[
        'brand-c:text-fog on-light:text-slate-ink on-steel:text-navy-deep text-base leading-[1.65] text-pretty',
        tone === 'light' ? 'text-azul-blue' : 'text-columbia-blue',
      ]}
    >
      {description}
    </p>
  )}
  <slot />
</div>
