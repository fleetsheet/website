---
import wordmarkLight from '@/assets/brand/fleet-logo-wordmark-light.png'
import wordmarkDark from '@/assets/brand/fleet-logo-wordmark.png'
import { websiteConfig } from '@/config'
import { Image } from 'astro:assets'

type Props = {
  size?: 'sm' | 'md' | 'lg'
  tone?: 'dark' | 'light'
  class?: string
}

const { size = 'md', tone = 'dark', class: className } = Astro.props

const wordmark = tone === 'dark' ? wordmarkDark : wordmarkLight
const height = { sm: 24, md: 28, lg: 32 }[size]
const width = Math.round((height * wordmark.width) / wordmark.height)
---

<Image
  src={wordmark}
  alt={websiteConfig.name}
  width={width}
  height={height}
  densities={[1, 2, 3]}
  loading="eager"
  class:list={['block', className]}
/>
