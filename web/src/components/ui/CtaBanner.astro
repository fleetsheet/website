---
import type { Photo as PhotoType } from '@/photos'
import Button from './Button.astro'
import Container from './Container.astro'
import Photo from './Photo.astro'

type Action = {
  label: string
  href: string
}

type Props = {
  id?: string
  title: string
  description?: string
  primaryAction: Action
  secondaryAction?: Action
  /** Shows the banner over this photo with a dark blue overlay and light text. */
  photo?: PhotoType
}

const { id, title, description, primaryAction, secondaryAction, photo } = Astro.props
---

<section id={id}>
  <Container width="wide" class="py-16">
    <div
      class:list={[
        'relative isolate flex flex-col items-center gap-5 overflow-hidden rounded-3xl p-[clamp(40px,6vw,80px)] text-center',
        // Over a photo: dark blue overlay and cream type. Otherwise a steel panel on
        // light pages, and the cream panel on the dark homepage.
        photo
          ? 'tone-dark text-cream'
          : 'tone-steel text-navy-deep brand-c:bg-cream brand-c:bg-none brand-c:text-black',
      ]}
      data-surface={photo ? undefined : 'light'}
    >
      {photo && (
        <>
          <Photo photo={photo} sizes="(min-width: 1280px) 1250px, 100vw" class="-z-10 grayscale" />
          <div class="bg-navy-deep/80 absolute inset-0 -z-10" aria-hidden="true" />
        </>
      )}
      <h2 class="text-display-lg max-w-[760px]">{title}</h2>
      {description && (
        <p
          class:list={[
            'max-w-[560px] text-lg leading-relaxed',
            photo ? 'text-cream/85' : 'text-navy-deep brand-c:text-slate-ink',
          ]}
        >
          {description}
        </p>
      )}
      <div class="mt-2 flex flex-wrap justify-center gap-3">
        <Button href={primaryAction.href} variant="accent" size="lg">
          {primaryAction.label}
        </Button>
        {secondaryAction && (
          <Button
            href={secondaryAction.href}
            variant="secondary"
            size="lg"
            class:list={[
              photo && 'border-fog! text-cream! hover:bg-navy! bg-transparent! bg-none!',
            ]}
          >
            {secondaryAction.label}
          </Button>
        )}
      </div>
    </div>
  </Container>
</section>
