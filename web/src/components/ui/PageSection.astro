---
import Container from './Container.astro'

type Props = {
  id?: string
  tone?: 'page' | 'surface' | 'inverse'
  width?: 'content' | 'wide'
  class?: string
  containerClass?: string
  /** Marks a light (cream) section inside a Palette C page. */
  surface?: 'light'
}

const {
  id,
  tone = 'page',
  width = 'content',
  class: className,
  containerClass,
  surface,
} = Astro.props
---

<section
  id={id}
  data-surface={surface}
  class:list={[
    tone === 'surface' &&
      'bg-surface border-border brand-c:bg-navy brand-c:border-hairline border-y',
    tone === 'inverse' && 'bg-rich-blue text-alice-blue brand-c:bg-navy brand-c:text-cream',
    className,
  ]}
>
  <Container width={width} class:list={['py-16', containerClass]}>
    <slot />
  </Container>
</section>
