---
import HeroScene from '@/components/home/HeroScene.astro'
import Button from '@/components/ui/Button.astro'
import Container from '@/components/ui/Container.astro'
import { getContent } from '@/data'
import { getLocale, localizePath } from '@/i18n'
import ArrowRight from '@lucide/astro/icons/arrow-right'
import Check from '@lucide/astro/icons/check'

const locale = getLocale(Astro.url)
const content = getContent(locale)
const { hero } = content.home
---

<section class="relative isolate overflow-hidden bg-black">
  <HeroScene />
  <Container class="relative flex min-h-[min(760px,calc(100svh-64px))] flex-col items-center justify-center gap-6 pt-20 pb-36 text-center sm:pb-44">
    <a
      href={localizePath(hero.announcement.href, locale)}
      class="border-hairline bg-navy-deep/70 text-fog hover:text-cream flex items-center gap-2 rounded-full border py-1.5 ps-1.5 pe-3.5 text-[13px] backdrop-blur-sm transition-colors"
    >
      <span class="bg-steel rounded-full px-2.5 py-0.5 font-medium text-black">
        {hero.announcement.label}
      </span>
      {hero.announcement.text}
      <span class="inline-block rtl:-scale-x-100" aria-hidden="true">
        →
      </span>
    </a>
    <h1 class="text-display-xl text-cream max-w-[900px]">{hero.title}</h1>
    <p class="text-lead text-fog max-w-[640px] text-pretty">{hero.description}</p>
    <div class="flex flex-wrap justify-center gap-3">
      <Button href={hero.primaryAction.href}>
        {hero.primaryAction.label}
        <ArrowRight class="size-4 rtl:-scale-x-100" aria-hidden="true" />
      </Button>
      <Button href={hero.secondaryAction.href} variant="secondary">
        {hero.secondaryAction.label}
      </Button>
    </div>
    <ul class="text-fog flex flex-wrap justify-center gap-5 text-sm">
      {hero.highlights.map((highlight) => (
        <li class="flex items-center gap-1.5">
          <Check class="text-steel size-4" aria-hidden="true" />
          {highlight}
        </li>
      ))}
    </ul>
  </Container>
</section>
