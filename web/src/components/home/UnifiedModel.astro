---
import Logo from '@/components/ui/Logo.astro'
import PageSection from '@/components/ui/PageSection.astro'
import SectionHeader from '@/components/ui/SectionHeader.astro'
import { getContent } from '@/data'
import { getLocale } from '@/i18n'
import Check from '@lucide/astro/icons/check'

const locale = getLocale(Astro.url)
const content = getContent(locale)
const { unifiedModel } = content.home
---

<PageSection tone="surface">
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] items-center gap-12">
    <SectionHeader
      eyebrow={unifiedModel.eyebrow}
      title={unifiedModel.title}
      description={unifiedModel.description}
    />
    <div class="flex flex-wrap items-center justify-center gap-4">
      <ul class="flex flex-[1_1_160px] flex-col gap-2" aria-label={content.site.labels.beforeFleet}>
        {unifiedModel.sources.map((source) => (
          <li class="border-cream/35 text-cream/85 rounded-[10px] border border-dashed px-3 py-2.5 text-sm">
            {source}
          </li>
        ))}
      </ul>
      <svg
        width="40"
        height="24"
        viewBox="0 0 40 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-steel rtl:-scale-x-100"
        aria-hidden="true"
      >
        <path d="M2 12h34"></path>
        <path d="m29 5 7 7-7 7"></path>
      </svg>
      <div class="bg-black border-hairline flex flex-[1_1_200px] flex-col gap-3 rounded-2xl border p-5">
        <Logo tone="light" />
        <ul class="flex flex-col gap-3" aria-label={content.site.labels.withFleet}>
          {unifiedModel.outputs.map((output) => (
            <li class="bg-navy text-cream flex items-center gap-2 rounded-[10px] px-3 py-[9px] text-sm">
              <Check class="text-steel size-3.5" stroke-width={2.5} aria-hidden="true" />
              {output}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</PageSection>
