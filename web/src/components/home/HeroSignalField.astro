---
/**
 * Homepage hero background: a signal field. An even grid of dots, with a
 * plus sign on a sparser regular lattice, lights up where slow beams of steel
 * and cream light pass. The light gathers at the edges and stays dim behind
 * the headline so the copy reads cleanly.
 *
 * Drawn on a canvas by the script below; it pauses off screen and draws a
 * single still frame for reduced motion.
 */
---

<div class="hero-field" aria-hidden="true" data-hero-field>
  <canvas></canvas>
</div>

<style>
  .hero-field {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    background-color: var(--color-black);
    mask-image: linear-gradient(to bottom, transparent, black 10%, black 86%, transparent);
  }

  .hero-field canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Keep the headline area quiet so the copy pops. */
  .hero-field::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 34% 44% at 50% 42%,
      rgb(0 0 0 / 0.78),
      rgb(0 0 0 / 0.35) 60%,
      transparent 90%
    );
  }
</style>

<script>
  type Rgb = [number, number, number]

  // Grid pitch in CSS pixels, and the lattice that carries plus signs.
  const GAP = 22
  const PLUS_EVERY_COLUMN = 6
  const PLUS_EVERY_ROW = 4

  const rgb = (value: string): Rgb => {
    const hex = value.trim().replace('#', '')
    const full =
      hex.length === 3
        ? hex
            .split('')
            .map((char) => char + char)
            .join('')
        : hex
    const channel = (index: number) => parseInt(full.slice(index, index + 2), 16)
    return [channel(0), channel(2), channel(4)]
  }

  const rgba = ([red, green, blue]: Rgb, alpha: number) =>
    `rgb(${red} ${green} ${blue} / ${alpha.toFixed(3)})`

  const mix = (from: Rgb, to: Rgb, amount: number): Rgb => [
    Math.round(from[0] + (to[0] - from[0]) * amount),
    Math.round(from[1] + (to[1] - from[1]) * amount),
    Math.round(from[2] + (to[2] - from[2]) * amount),
  ]

  const smoothstep = (edge0: number, edge1: number, x: number) => {
    const t = Math.min(1, Math.max(0, (x - edge0) / (edge1 - edge0)))
    return t * t * (3 - 2 * t)
  }

  // A fixed per-cell value in [0, 1) so twinkles land in the same places.
  const hash = (column: number, row: number) => {
    const value = Math.sin(column * 12.9898 + row * 78.233) * 43758.5453
    return value - Math.floor(value)
  }

  let stop: (() => void) | undefined

  document.addEventListener('astro:page-load', () => {
    stop?.()
    stop = undefined

    const field = document.querySelector<HTMLElement>('[data-hero-field]')
    const canvas = field?.querySelector('canvas')
    const context = canvas?.getContext('2d')
    if (!field || !canvas || !context) {
      return
    }

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const styles = getComputedStyle(document.documentElement)
    const steel = rgb(styles.getPropertyValue('--color-steel'))
    const cream = rgb(styles.getPropertyValue('--color-cream'))

    let width = 0
    let height = 0

    const resize = () => {
      const ratio = Math.min(window.devicePixelRatio || 1, 2)
      width = field.clientWidth
      height = field.clientHeight
      canvas.width = Math.round(width * ratio)
      canvas.height = Math.round(height * ratio)
      context.setTransform(ratio, 0, 0, ratio, 0, 0)
    }

    const draw = (t: number) => {
      context.globalCompositeOperation = 'source-over'
      context.clearRect(0, 0, width, height)
      context.globalCompositeOperation = 'lighter'

      // Light sources that drift slowly along the edges and the bottom.
      const reach = Math.max(width, 720)
      const sources = [
        {
          x: width * (0.98 + 0.03 * Math.sin(t * 0.21)),
          y: height * (0.6 + 0.14 * Math.sin(t * 0.17)),
          radius: reach * 0.26,
          strength: 1,
        },
        {
          x: width * (0.02 + 0.03 * Math.sin(t * 0.19 + 2)),
          y: height * (0.78 + 0.1 * Math.sin(t * 0.23 + 1)),
          radius: reach * 0.21,
          strength: 0.8,
        },
        {
          x: width * (0.5 + 0.42 * Math.sin(t * 0.08)),
          y: height * 1.04,
          radius: reach * 0.2,
          strength: 0.5,
        },
      ]

      // A soft steel underglow beneath each source.
      for (const source of sources) {
        const glow = context.createRadialGradient(
          source.x,
          source.y,
          0,
          source.x,
          source.y,
          source.radius * 1.5,
        )
        glow.addColorStop(0, rgba(steel, 0.62 * source.strength))
        glow.addColorStop(0.5, rgba(steel, 0.2 * source.strength))
        glow.addColorStop(1, rgba(steel, 0))
        context.fillStyle = glow
        context.fillRect(0, 0, width, height)
      }

      const columns = Math.ceil(width / GAP) + 1
      const rows = Math.ceil(height / GAP) + 1
      const startX = (width - (columns - 1) * GAP) / 2
      const startY = (height - (rows - 1) * GAP) / 2

      for (let row = 0; row < rows; row++) {
        const y = startY + row * GAP
        // Dark at the top, like light rising from below.
        const rise = 0.2 + 0.8 * smoothstep(height * 0.05, height * 0.55, y)

        for (let column = 0; column < columns; column++) {
          const x = startX + column * GAP

          let level = 0
          for (const source of sources) {
            const distance = ((x - source.x) ** 2 + (y - source.y) ** 2) / source.radius ** 2
            level += source.strength * Math.exp(-distance * 2.2)
          }

          // A slow diagonal sweep of light across the whole field.
          const phase = (x / width) * 1.1 + (y / height) * 0.45 - t * 0.055
          const sweep = Math.exp(-(((phase - Math.floor(phase) - 0.5) / 0.07) ** 2))
          level += 0.38 * sweep

          // Occasional single cells that flare and fade.
          const seed = hash(column, row)
          level += 0.5 * Math.max(0, Math.sin(t * 0.7 + seed * 40)) ** 24 * (seed > 0.6 ? 1 : 0)

          const quiet =
            1 -
            0.88 *
              Math.exp(
                -(
                  ((x - width / 2) / Math.max(width * 0.3, 240)) ** 2 +
                  ((y - height * 0.45) / (height * 0.32)) ** 2
                ),
              )
          level = Math.min(1, 1.1 * level * quiet * rise)

          const color = mix(steel, cream, smoothstep(0.78, 1, level))
          const alpha = 0.06 + 0.94 * level

          // A faint halo makes the brightest points glow without touching neighbours.
          if (level > 0.3) {
            context.fillStyle = rgba(color, 0.22 * level * level)
            context.beginPath()
            context.arc(x, y, 2.5 + 3.5 * level, 0, Math.PI * 2)
            context.fill()
          }

          if (column % PLUS_EVERY_COLUMN === 3 && row % PLUS_EVERY_ROW === 2) {
            const arm = 3.5 + level
            context.strokeStyle = rgba(color, Math.min(1, alpha + 0.06))
            context.lineWidth = 1
            context.beginPath()
            context.moveTo(x - arm, y)
            context.lineTo(x + arm, y)
            context.moveTo(x, y - arm)
            context.lineTo(x, y + arm)
            context.stroke()
          } else {
            context.fillStyle = rgba(color, alpha)
            context.beginPath()
            context.arc(x, y, 0.9 + 0.8 * level, 0, Math.PI * 2)
            context.fill()
          }
        }
      }
    }

    // The still frame for reduced motion.
    const STILL = 9

    const resizer = new ResizeObserver(() => {
      resize()
      if (reduced) {
        draw(STILL)
      }
    })
    resizer.observe(field)
    resize()

    if (reduced) {
      draw(STILL)
      stop = () => resizer.disconnect()
      return
    }

    let frame = 0
    let last = 0
    let visible = true
    const start = performance.now()

    const render = (now: number) => {
      frame = requestAnimationFrame(render)
      // About 30 frames a second is plenty for slow ambient motion.
      if (!visible || now - last < 33) {
        return
      }
      last = now
      draw((now - start) / 1000 + STILL)
    }

    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting
    })
    observer.observe(field)
    const onVisibility = () => {
      visible = document.visibilityState === 'visible'
    }
    document.addEventListener('visibilitychange', onVisibility)
    frame = requestAnimationFrame(render)

    stop = () => {
      cancelAnimationFrame(frame)
      resizer.disconnect()
      observer.disconnect()
      document.removeEventListener('visibilitychange', onVisibility)
    }
  })
</script>
