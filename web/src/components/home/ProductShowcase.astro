---
import Badge from '@/components/ui/Badge.astro'
import Container from '@/components/ui/Container.astro'
import IconChip from '@/components/ui/IconChip.astro'
import Logo from '@/components/ui/Logo.astro'
import MockPanel from '@/components/ui/MockPanel.astro'
import { getContent } from '@/data'
import { getLocale } from '@/i18n'
import Box from '@lucide/astro/icons/box'
import Building from '@lucide/astro/icons/building'
import ChartLine from '@lucide/astro/icons/chart-line'
import ClipboardList from '@lucide/astro/icons/clipboard-list'
import LayoutDashboard from '@lucide/astro/icons/layout-dashboard'
import Sparkles from '@lucide/astro/icons/sparkles'
import Workflow from '@lucide/astro/icons/workflow'

const locale = getLocale(Astro.url)
const content = getContent(locale)
const { showcase } = content.home

const navItems = [
  { label: 'Dashboard', icon: LayoutDashboard, active: true },
  { label: 'Work orders', icon: ClipboardList },
  { label: 'Locations', icon: Building },
  { label: 'Assets', icon: Box },
  { label: 'Workflows', icon: Workflow },
  { label: 'Reports', icon: ChartLine },
]

const { prediction } = showcase
---

<section aria-label={content.site.labels.productPreview}>
  <Container width="wide" class="pb-16">
    <div class="flex flex-wrap items-start gap-5" aria-hidden="true">
      <div class="bg-surface text-rich-blue shadow-float brand-c:bg-black brand-c:border brand-c:border-cream brand-c:shadow-none brand-c:rounded-2xl flex min-w-0 flex-[1_1_600px] overflow-hidden rounded-xl">
        <aside class="bg-navy-deep border-hairline brand-c:bg-black brand-c:border-hairline hidden w-[188px] shrink-0 flex-col gap-1 border-r px-3 py-4 sm:flex">
          <div class="px-2 pt-1 pb-4">
            <Logo size="sm" tone="light" />
          </div>
          {navItems.map(({ label, icon: Icon, active }) => (
            <div
              class:list={[
                'font-display flex items-center gap-2.5 rounded-md p-2 text-[13px]',
                active ? 'bg-navy text-cream' : 'text-uranian-blue brand-c:text-fog',
              ]}
            >
              <Icon class="size-4" />
              {label}
            </div>
          ))}
        </aside>
        <div class="bg-page brand-c:bg-navy-deep brand-c:text-cream flex min-w-0 flex-1 flex-col gap-5 p-4 sm:p-6">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <p class="font-display brand-c:font-light text-xl font-semibold tracking-[-0.02em]">
                {showcase.greeting}
              </p>
              <p class="text-azul-blue brand-c:text-fog text-[13px]">{showcase.scope}</p>
            </div>
            <div class="flex gap-1.5">
              {showcase.filters.map((filter) => (
                <span class="bg-surface border-border brand-c:bg-transparent brand-c:border-hairline brand-c:text-fog brand-c:rounded-full rounded-md border px-2.5 py-1.5 text-xs font-medium">
                  {filter}
                </span>
              ))}
            </div>
          </div>
          <div class="grid grid-cols-3 gap-2 sm:gap-3">
            {showcase.stats.map((stat) => (
              <div class="bg-surface border-border brand-c:bg-navy brand-c:border-hairline brand-c:shadow-none rounded-xl border p-2.5 shadow-xs sm:p-3.5">
                <p class="text-azul-blue brand-c:text-cream/80 text-xs">{stat.label}</p>
                <p class="font-display brand-c:font-light mt-1 text-lg font-semibold sm:text-2xl">
                  {stat.value}
                </p>
              </div>
            ))}
          </div>
          <div class="bg-surface border-border brand-c:bg-black brand-c:border-hairline brand-c:shadow-none grid grid-cols-[minmax(0,1fr)_auto] overflow-hidden rounded-xl border shadow-xs sm:grid-cols-[auto_minmax(0,1fr)_auto]">
            <p class="font-display border-border brand-c:border-hairline col-span-full border-b px-4 py-3 text-sm font-semibold">
              Work orders
            </p>
            {showcase.workOrders.map((order) => (
              <div class="brand-c:border-hairline col-span-full grid grid-cols-subgrid items-center gap-3 border-b border-slate-100 px-4 py-[11px] text-[13px] last:border-b-0">
                <span class="text-muted brand-c:text-fog hidden font-mono text-[11px] whitespace-nowrap sm:block">
                  {order.id}
                </span>
                <div class="min-w-0">
                  <p class="truncate font-semibold">{order.title}</p>
                  <p class="text-muted brand-c:text-fog truncate text-xs">{order.location}</p>
                </div>
                <Badge tone={order.tone} class="justify-self-start">
                  {order.status}
                </Badge>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="flex min-w-0 flex-[1_1_280px] flex-col gap-4">
        <MockPanel elevation="float" class="brand-c:border-cream! flex flex-col gap-3 p-[18px]">
          <div class="flex items-center gap-2.5">
            <IconChip>
              <Sparkles />
            </IconChip>
            <div class="flex-1">
              <p class="font-display text-[13px] font-semibold">{prediction.title}</p>
              <p class="text-muted brand-c:text-fog text-xs">{prediction.asset}</p>
            </div>
            <Badge tone="overdue">{prediction.risk}</Badge>
          </div>
          <p class="text-sm leading-normal">{prediction.message}</p>
          <div class="flex h-10 items-end gap-[3px]">
            {prediction.trend.map((value, index) => (
              <div
                class:list={[
                  'flex-1 rounded-xs',
                  index >= prediction.alertFrom
                    ? 'bg-sun-orange brand-c:bg-status-high'
                    : 'bg-uranian-blue brand-c:bg-steel/45',
                ]}
                style={`height: ${value}%`}
              />
            ))}
          </div>
          <div class="border-border brand-c:border-hairline flex items-center justify-between gap-2 border-t pt-2.5">
            <span class="text-muted brand-c:text-fog text-xs">{prediction.rule}</span>
            <span class="bg-rich-blue text-alice-blue brand-c:bg-cream brand-c:text-espresso rounded-md px-2.5 py-1.5 text-xs font-semibold">
              {prediction.action}
            </span>
          </div>
        </MockPanel>
        <MockPanel elevation="float" class="brand-c:border-cream! flex flex-col gap-2.5 p-[18px]">
          <p class="font-display text-[13px] font-semibold">{content.site.labels.auditLog}</p>
          {showcase.audit.map((entry) => (
            <div class="flex gap-2.5 text-xs leading-[1.4]">
              <span class="bg-celestial-blue brand-c:bg-steel mt-1 size-2 shrink-0 rounded-full" />
              <p class="flex-1">
                <span class="font-semibold">{entry.who}</span> {entry.what}
              </p>
              <span class="text-muted brand-c:text-fog whitespace-nowrap">{entry.when}</span>
            </div>
          ))}
        </MockPanel>
      </div>
    </div>
  </Container>
</section>
