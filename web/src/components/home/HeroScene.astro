---
/**
 * Homepage hero background: an isometric field of frosted-glass building blocks.
 * Blocks rise towards the left and right edges and stay low and dim behind the
 * headline (a "valley"), so the copy reads cleanly. A slow light wave mixes
 * steel and cream across their tops while each block breathes up and down.
 *
 * The first frame is rendered here so the scene shows without JavaScript; the
 * script below animates it and stops for reduced motion or when off screen.
 */

// Viewbox and isometric tile geometry (half-width and half-height of a tile).
const W = 1600
const H = 900
const ORIGIN_X = W / 2
const ORIGIN_Y = 430
const A = 96
const B = 55.4
const INSET = 0.88

// Deterministic pseudo-random numbers so every build draws the same scene.
let seed = 7
const random = () => {
  seed = (seed * 16807) % 2147483647
  return (seed - 1) / 2147483646
}

const smoothstep = (edge0: number, edge1: number, x: number) => {
  const t = Math.min(1, Math.max(0, (x - edge0) / (edge1 - edge0)))
  return t * t * (3 - 2 * t)
}

type Block = {
  x: number
  y: number
  height: number
  phase: number
  speed: number
  wave: number
  opacity: number
}

const blocks: Block[] = []
for (let i = -8; i <= 8; i++) {
  for (let j = -8; j <= 8; j++) {
    const x = ORIGIN_X + (i - j) * A
    const y = ORIGIN_Y + (i + j) * B
    if (x < -A || x > W + A || y < ORIGIN_Y - 3 * B || y > H + 3 * B) continue
    if (random() < 0.18) continue

    const side = Math.abs(x - ORIGIN_X) / ORIGIN_X
    // Valley: tall at the edges, low in the middle, slightly taller further back.
    const valley = smoothstep(0.16, 0.98, side)
    const depth = 1 - smoothstep(ORIGIN_Y, H, y) * 0.35
    const height = 6 + 300 * valley ** 1.6 * depth * (0.45 + random() * 0.55) + random() * 12

    // Fade far rows into the dark, and tone down blocks behind the headline.
    const far = smoothstep(ORIGIN_Y - 3 * B, ORIGIN_Y + 2 * B, y)
    const behindText = Math.exp(-(((x - ORIGIN_X) / 380) ** 2)) * (1 - smoothstep(600, 900, y))
    const opacity = far * (1 - 0.7 * behindText)
    if (opacity < 0.06) continue

    blocks.push({
      x,
      y,
      height,
      phase: random() * Math.PI * 2,
      speed: 0.35 + random() * 0.35,
      wave: (i * 0.32 + j * 0.18) % (Math.PI * 2),
      opacity,
    })
  }
}
// Paint back to front.
blocks.sort((first, second) => first.y - second.y || first.x - second.x)

const point = (x: number, y: number) => `${x.toFixed(1)} ${y.toFixed(1)}`

const faces = (x: number, y: number, h: number) => {
  const a = A * INSET
  const b = B * INSET
  const left = point(x - a, y)
  const bottom = point(x, y + b)
  const right = point(x + a, y)
  const leftTop = point(x - a, y - h)
  const bottomTop = point(x, y + b - h)
  const rightTop = point(x + a, y - h)
  const backTop = point(x, y - b - h)
  return {
    left: `M${left}L${bottom}L${bottomTop}L${leftTop}Z`,
    right: `M${bottom}L${right}L${rightTop}L${bottomTop}Z`,
    top: `M${backTop}L${rightTop}L${bottomTop}L${leftTop}Z`,
    rim: `M${leftTop}L${bottomTop}L${rightTop}`,
    edge: `M${bottomTop}L${bottom}`,
  }
}
---

<div class="hero-scene" aria-hidden="true" data-hero-scene>
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax slice">
    <defs>
      <linearGradient id="hero-face-left" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color: var(--color-steel); stop-opacity: 0.42"></stop>
        <stop offset="1" style="stop-color: var(--color-navy); stop-opacity: 0.14"></stop>
      </linearGradient>
      <linearGradient id="hero-face-right" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color: var(--color-steel); stop-opacity: 0.24"></stop>
        <stop offset="1" style="stop-color: var(--color-navy); stop-opacity: 0.08"></stop>
      </linearGradient>
      <linearGradient id="hero-face-top" x1="0.5" y1="1" x2="0.5" y2="0">
        <stop offset="0" style="stop-color: var(--color-cream); stop-opacity: 0.26"></stop>
        <stop offset="0.55" style="stop-color: var(--color-steel); stop-opacity: 0.2"></stop>
        <stop offset="1" style="stop-color: var(--color-steel); stop-opacity: 0.04"></stop>
      </linearGradient>
      <linearGradient id="hero-edge" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color: var(--color-cream); stop-opacity: 0.55"></stop>
        <stop offset="1" style="stop-color: var(--color-steel); stop-opacity: 0"></stop>
      </linearGradient>
    </defs>
    {blocks.map((block) => {
      const shape = faces(block.x, block.y, block.height)
      return (
        <g
          class="hero-block"
          style={`opacity: ${block.opacity.toFixed(3)}`}
          data-x={block.x.toFixed(1)}
          data-y={block.y.toFixed(1)}
          data-h={block.height.toFixed(1)}
          data-phase={block.phase.toFixed(3)}
          data-speed={block.speed.toFixed(3)}
          data-wave={block.wave.toFixed(3)}
        >
          <path d={shape.left} fill="url(#hero-face-left)" data-face="left" />
          <path d={shape.right} fill="url(#hero-face-right)" data-face="right" />
          <path d={shape.top} fill="url(#hero-face-top)" data-face="top" />
          <path d={shape.top} class="hero-glow" data-face="glow" />
          <path d={shape.rim} class="hero-rim-soft" data-face="rim-soft" />
          <path d={shape.rim} class="hero-rim" data-face="rim" />
          <path d={shape.edge} stroke="url(#hero-edge)" class="hero-edge" data-face="edge" />
        </g>
      )
    })}
  </svg>
</div>

<style>
  .hero-scene {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 55% at 50% 105%, rgb(50 63 103 / 0.55), transparent 70%),
      var(--color-black);
    mask-image: linear-gradient(to bottom, transparent, black 12%, black 88%, transparent);
  }

  /* On narrow screens keep at least the inner slopes of the valley in view. */
  .hero-scene svg {
    position: absolute;
    inset-block: 0;
    left: 50%;
    width: max(100%, 1100px);
    height: 100%;
    transform: translateX(-50%);
  }

  /* Keep the headline area quiet so the copy pops. */
  .hero-scene::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 38% 46% at 50% 40%,
      rgb(0 0 0 / 0.82),
      rgb(0 0 0 / 0.45) 55%,
      transparent 85%
    );
  }

  .hero-glow {
    fill: var(--color-steel);
    fill-opacity: 0.12;
  }

  .hero-rim {
    fill: none;
    stroke: var(--color-cream);
    stroke-opacity: 0.32;
    stroke-width: 1;
    stroke-linejoin: round;
  }

  /* A wider, faint copy of the rim reads as a soft, toned-down glow. */
  .hero-rim-soft {
    fill: none;
    stroke: var(--color-steel);
    stroke-opacity: 0.1;
    stroke-width: 6;
    stroke-linejoin: round;
  }

  .hero-edge {
    fill: none;
    stroke-width: 1;
  }
</style>

<script>
  type Face = 'left' | 'right' | 'top' | 'glow' | 'rim-soft' | 'rim' | 'edge'

  const A = 96 * 0.88
  const B = 55.4 * 0.88

  const point = (x: number, y: number) => `${x.toFixed(1)} ${y.toFixed(1)}`

  const paths = (x: number, y: number, h: number): Record<Face, string> => {
    const left = point(x - A, y)
    const bottom = point(x, y + B)
    const right = point(x + A, y)
    const leftTop = point(x - A, y - h)
    const bottomTop = point(x, y + B - h)
    const rightTop = point(x + A, y - h)
    const backTop = point(x, y - B - h)
    const top = `M${backTop}L${rightTop}L${bottomTop}L${leftTop}Z`
    const rim = `M${leftTop}L${bottomTop}L${rightTop}`
    return {
      left: `M${left}L${bottom}L${bottomTop}L${leftTop}Z`,
      right: `M${bottom}L${right}L${rightTop}L${bottomTop}Z`,
      top,
      glow: top,
      'rim-soft': rim,
      rim,
      edge: `M${bottomTop}L${bottom}`,
    }
  }

  const rgb = (value: string) => {
    const hex = value.trim().replace('#', '')
    const full =
      hex.length === 3
        ? hex
            .split('')
            .map((char) => char + char)
            .join('')
        : hex
    return [0, 2, 4].map((index) => parseInt(full.slice(index, index + 2), 16))
  }

  let stop: (() => void) | undefined

  document.addEventListener('astro:page-load', () => {
    stop?.()
    stop = undefined

    const scene = document.querySelector<HTMLElement>('[data-hero-scene]')
    if (!scene || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return
    }

    const styles = getComputedStyle(document.documentElement)
    const steel = rgb(styles.getPropertyValue('--color-steel'))
    const cream = rgb(styles.getPropertyValue('--color-cream'))

    const blocks = [...scene.querySelectorAll<SVGGElement>('.hero-block')].map((group) => ({
      x: Number(group.dataset.x),
      y: Number(group.dataset.y),
      h: Number(group.dataset.h),
      phase: Number(group.dataset.phase),
      speed: Number(group.dataset.speed),
      wave: Number(group.dataset.wave),
      faces: Object.fromEntries(
        [...group.querySelectorAll<SVGPathElement>('[data-face]')].map((path) => [
          path.dataset.face,
          path,
        ]),
      ) as Record<Face, SVGPathElement>,
    }))

    let frame = 0
    let last = 0
    let visible = true
    const start = performance.now()

    const render = (now: number) => {
      frame = requestAnimationFrame(render)
      // About 30 frames a second is plenty for slow ambient motion.
      if (!visible || now - last < 33) {
        return
      }
      last = now
      const t = (now - start) / 1000

      for (const block of blocks) {
        // Breathing height: a gentle swell around each block's base height.
        const height = Math.max(
          4,
          block.h * (1 + 0.1 * Math.sin(t * block.speed + block.phase)) +
            5 * Math.sin(t * 0.6 + block.phase * 2),
        )
        const shape = paths(block.x, block.y, height)
        for (const face of Object.keys(shape) as Face[]) {
          block.faces[face]?.setAttribute('d', shape[face])
        }

        // A slow light wave mixes steel and cream across the tops.
        const mix = 0.5 + 0.5 * Math.sin(t * 0.45 - block.wave)
        const color = steel.map((channel, index) =>
          Math.round(channel + (cream[index] - channel) * mix),
        )
        const glow = block.faces.glow
        glow.style.fill = `rgb(${color.join(' ')})`
        glow.style.fillOpacity = (0.06 + 0.16 * mix ** 2).toFixed(3)
      }
    }

    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting
    })
    observer.observe(scene)
    const onVisibility = () => {
      visible = document.visibilityState === 'visible'
    }
    document.addEventListener('visibilitychange', onVisibility)
    frame = requestAnimationFrame(render)

    stop = () => {
      cancelAnimationFrame(frame)
      observer.disconnect()
      document.removeEventListener('visibilitychange', onVisibility)
    }
  })
</script>
