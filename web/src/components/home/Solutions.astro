---
import Badge from '@/components/ui/Badge.astro'
import CheckList from '@/components/ui/CheckList.astro'
import PageSection from '@/components/ui/PageSection.astro'
import SectionHeader from '@/components/ui/SectionHeader.astro'
import { getContent } from '@/data'
import { getLocale } from '@/i18n'
import MapPin from '@lucide/astro/icons/map-pin'

const locale = getLocale(Astro.url)
const content = getContent(locale)
const { solutions } = content.home

const tabId = (index: number) => `solutions-tab-${index}`
const panelId = (index: number) => `solutions-panel-${index}`
---

<PageSection id="solutions" tone="surface" containerClass="flex flex-col gap-8">
  <SectionHeader eyebrow={solutions.eyebrow} title={solutions.title} />

  <div data-tabs class="flex flex-col gap-8">
    <div
      role="tablist"
      aria-label={solutions.eyebrow}
      class="bg-navy-deep border-hairline flex max-w-full flex-wrap gap-1.5 self-start rounded-full border p-1"
    >
      {solutions.sectors.map((sector, index) => (
        <button
          type="button"
          role="tab"
          id={tabId(index)}
          aria-controls={panelId(index)}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          class="text-fog hover:text-cream aria-selected:bg-cream aria-selected:text-espresso focus-visible:outline-steel cursor-pointer rounded-full px-3.5 py-2 text-sm font-medium transition-colors"
        >
          {sector.label}
        </button>
      ))}
    </div>

    {solutions.sectors.map((sector, index) => (
      <div
        role="tabpanel"
        id={panelId(index)}
        aria-labelledby={tabId(index)}
        hidden={index !== 0}
        class="bg-black border-hairline grid grid-cols-[repeat(auto-fit,minmax(min(100%,360px),1fr))] items-center gap-10 rounded-3xl border p-[clamp(24px,3vw,40px)]"
      >
        <div class="flex flex-col gap-4">
          <h3 class="text-cream text-[28px] font-light tracking-[-0.025em]">{sector.title}</h3>
          <p class="text-fog leading-[1.65]">{sector.description}</p>
          <CheckList items={sector.points} />
        </div>
        <div class="bg-navy-deep flex flex-col gap-2.5 rounded-2xl p-5" aria-hidden="true">
          <p class="text-fog flex items-center gap-2 text-[13px]">
            <MapPin class="text-steel size-4" />
            <span class="font-medium">{sector.site}</span>
          </p>
          {sector.tasks.map((task) => (
            <div class="bg-navy border-hairline text-cream flex items-center gap-3 rounded-[10px] border px-3.5 py-3 text-sm">
              <div class="min-w-0 flex-1">
                <p>{task.title}</p>
                <p class="text-fog text-xs">{task.location}</p>
              </div>
              <Badge tone={task.tone}>{task.status}</Badge>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</PageSection>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'))

      const select = (next: HTMLButtonElement) => {
        tabs.forEach((tab) => {
          const selected = tab === next
          tab.setAttribute('aria-selected', String(selected))
          tab.tabIndex = selected ? 0 : -1
          const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '')
          if (panel) {
            panel.hidden = !selected
          }
        })
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => select(tab))
        tab.addEventListener('keydown', (event) => {
          const direction = document.documentElement.dir === 'rtl' ? -1 : 1
          const offset = { ArrowRight: direction, ArrowLeft: -direction }[event.key]
          if (offset === undefined) {
            return
          }
          event.preventDefault()
          const next = tabs[(index + offset + tabs.length) % tabs.length]
          select(next)
          next.focus()
        })
      })
    })
  })
</script>
