---
import Badge from '@/components/ui/Badge.astro'
import FeatureCard from '@/components/ui/FeatureCard.astro'
import MockPanel from '@/components/ui/MockPanel.astro'
import PageSection from '@/components/ui/PageSection.astro'
import SectionHeader from '@/components/ui/SectionHeader.astro'
import { getContent } from '@/data'
import { getLocale } from '@/i18n'
import Box from '@lucide/astro/icons/box'
import FileText from '@lucide/astro/icons/file-text'

const locale = getLocale(Astro.url)
const content = getContent(locale)
const { platform } = content.home

const { workOrders, assets, documents, workflows, auditLogs, mobile } = platform

const stepStyles = ['bg-steel text-black', 'bg-cream text-espresso', 'bg-navy text-cream']
---

<PageSection
  id="platform"
  class="to-steel-mist bg-linear-to-b from-white"
  surface="light"
  containerClass="flex flex-col gap-12"
>
  <SectionHeader
    eyebrow={platform.eyebrow}
    title={platform.title}
    description={platform.description}
  />
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,340px),1fr))] gap-5">
    <FeatureCard title={workOrders.title} description={workOrders.description}>
      <MockPanel padding="xs" class="grid grid-cols-[auto_minmax(0,1fr)_auto]">
        {workOrders.items.map((item) => (
          <div class="col-span-full grid grid-cols-subgrid items-center gap-2.5 p-2.5 text-[13px]">
            <span class="bg-navy text-steel flex size-7 shrink-0 items-center justify-center rounded-full text-[11px] font-medium">
              {item.initials}
            </span>
            <p class="leading-snug">{item.title}</p>
            <Badge tone={item.tone} class="justify-self-start">
              {item.status}
            </Badge>
          </div>
        ))}
      </MockPanel>
    </FeatureCard>

    <FeatureCard title={assets.title} description={assets.description}>
      <MockPanel class="flex flex-col gap-3">
        <div class="flex items-center gap-2.5">
          <span class="bg-navy text-steel flex size-9 shrink-0 items-center justify-center rounded-[10px]">
            <Box class="size-[18px]" />
          </span>
          <div class="flex-1">
            <p class="text-sm font-medium">{assets.asset.name}</p>
            <p class="text-fog text-xs">{assets.asset.location}</p>
          </div>
          <Badge tone="done">{assets.asset.status}</Badge>
        </div>
        <dl class="grid grid-cols-3 gap-2 text-xs">
          {assets.asset.facts.map((fact) => (
            <div class="bg-navy rounded-md p-2">
              <dt class="text-fog">{fact.label}</dt>
              <dd class="mt-0.5 font-medium">{fact.value}</dd>
            </div>
          ))}
        </dl>
      </MockPanel>
    </FeatureCard>

    <FeatureCard title={documents.title} description={documents.description}>
      <MockPanel padding="xs" class="grid grid-cols-[auto_minmax(0,1fr)_auto]">
        {documents.items.map((item) => (
          <div class="col-span-full grid grid-cols-subgrid items-center gap-2.5 p-2.5 text-[13px]">
            <FileText class="text-steel size-[18px]" />
            <div class="min-w-0">
              <p class="leading-snug">{item.title}</p>
              <p class="text-fog text-xs">{item.location}</p>
            </div>
            <Badge tone={item.tone} class="justify-self-start">
              {item.status}
            </Badge>
          </div>
        ))}
      </MockPanel>
    </FeatureCard>

    <FeatureCard title={workflows.title} description={workflows.description}>
      <div class="flex flex-col">
        {workflows.steps.map((step, index) => (
          <div class="flex flex-col items-start">
            <div class="bg-navy-deep border-hairline text-cream flex w-full items-center gap-2.5 rounded-[10px] border px-3 py-2.5 text-[13px]">
              <span
                class:list={[
                  'rounded-sm px-1.5 py-0.5 text-[10px] font-medium tracking-[0.08em] uppercase',
                  stepStyles[index % stepStyles.length],
                ]}
              >
                {step.kind}
              </span>
              <span>{step.text}</span>
            </div>
            {index < workflows.steps.length - 1 && <div class="bg-steel/50 ms-6 h-3.5 w-px" />}
          </div>
        ))}
      </div>
    </FeatureCard>

    <FeatureCard title={auditLogs.title} description={auditLogs.description}>
      <MockPanel class="flex flex-col gap-3.5">
        {auditLogs.entries.map((entry) => (
          <div class="flex gap-2.5 text-[13px] leading-[1.4]">
            <span class="text-fog w-10 shrink-0 pt-px font-mono text-[11px]">{entry.when}</span>
            <p class="flex-1">
              <span class="font-medium">{entry.who}</span> {entry.what}
            </p>
          </div>
        ))}
      </MockPanel>
    </FeatureCard>

    <FeatureCard title={mobile.title} description={mobile.description} class="overflow-hidden">
      <div class="bg-black border-hairline mx-auto -mb-12 w-60 rounded-t-[28px] border px-2.5 pt-2.5">
        <div class="bg-navy-deep text-cream flex flex-col gap-2.5 rounded-t-[20px] px-3.5 pt-4 pb-14">
          <p class="text-sm font-medium">{mobile.heading}</p>
          <div class="border-hairline flex flex-col gap-2 rounded-[10px] border bg-black p-3">
            <div class="flex flex-col items-start gap-1.5">
              <span class="text-[13px] font-medium">{mobile.task.title}</span>
              <Badge tone={mobile.task.tone}>{mobile.task.status}</Badge>
            </div>
            <p class="text-fog text-xs">{mobile.task.location}</p>
            <div class="flex gap-1.5">
              {mobile.actions.map((action, index) => (
                <span
                  class:list={[
                    'flex-1 rounded-md p-[7px] text-center text-[11px] font-medium',
                    index === 0 ? 'bg-cream text-espresso' : 'border-hairline text-fog border',
                  ]}
                >
                  {action}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </FeatureCard>
  </div>
</PageSection>
